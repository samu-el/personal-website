---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { site } from '@/lib/site';
import { Icon } from 'astro-icon/components';
import SocialLinks from '@/components/SocialLinks.astro';

const title = 'Contact';
const description = 'Contact Samuel Mussie, software engineer in Addis Ababa, Ethiopia. Email or LinkedIn.';

/** Each row is one email with its subject filled in; the heading is the whole label. */
const routes = [
  { heading: 'Project work', icon: 'lucide:package-check', subject: 'Project enquiry' },
  { heading: 'Roles', icon: 'lucide:briefcase', subject: 'Role enquiry' },
  { heading: 'AI features', icon: 'lucide:sparkles', subject: 'AI feature' },
  { heading: 'Anything else', icon: 'lucide:message-square-quote', subject: '' },
].map((r) => ({
  ...r,
  href: `mailto:${site.email}${r.subject ? `?subject=${encodeURIComponent(r.subject)}` : ''}`,
}));
---

<Layout {title} {description} path="/contact" bareFooter>
  <PageHeader>
    Get in touch.
    <p slot="after" class="display mt-6 text-[clamp(1.75rem,3.4vw,3rem)] text-accent" data-reveal>
      {site.email}
    </p>
    <div slot="after" class="relative mt-10 flex flex-wrap gap-3" data-reveal style="--reveal-delay:120ms">
      <a href={`mailto:${site.email}`} class="btn btn-primary">
        <Icon name="lucide:mail" class="size-4" aria-hidden="true" />
        Email me
      </a>
      <button type="button" id="copy-email" class="btn btn-ghost">
        <Icon name="lucide:copy" class="size-4" aria-hidden="true" />
        <span data-copy-label>Copy address</span>
      </button>
      <!-- The label change is visual; this is what a screen reader hears. -->
      <span id="copy-email-status" class="sr-only" role="status" aria-live="polite"></span>
    </div>
  </PageHeader>

  <!-- Routes: a numbered ledger rather than four boxes. The whole row is the
       link, so the heading is its label and there is nothing to explain. -->
  <div class="wrap sec-follow">
    <ol class="ledger">
      {
        routes.map((r, i) => (
          <li class="ledger-row" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <a
              href={r.href}
              class="group grid grid-cols-[2.5rem_1fr_auto] items-baseline gap-4 py-8 transition-colors sm:grid-cols-12 sm:gap-6 lg:py-12"
            >
              <span class="numeral text-[1.75rem] text-subtle sm:col-span-1">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="display text-section transition-colors group-hover:text-accent sm:col-span-9">{r.heading}</h2>
              <span class="flex items-center gap-2 self-center text-subtle sm:col-span-2 sm:justify-end">
                <Icon name={r.icon} class="size-4" aria-hidden="true" />
                <Icon
                  name="lucide:arrow-right"
                  class="size-4 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-accent"
                  aria-hidden="true"
                />
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <SocialLinks
      class="ledger mt-14 lg:mt-24 lg:max-w-[50%]"
      rowClass="hit flex items-center justify-between gap-4 py-3.5 text-[0.9375rem] text-fg transition-colors"
      iconClass="size-4"
    />
  </div>

  <!-- A colophon: the contact page is itself the close, so no repeat of it. -->
  <footer class="border-t border-line bg-sunken">
    <div class="wrap flex flex-col gap-3 py-10 sm:flex-row sm:items-center sm:justify-between">
      <p class="meta">© {new Date().getFullYear()} {site.name}</p>
      <p class="meta">{site.location}</p>
    </div>
  </footer>
</Layout>

<script>
  import { copyEmail } from '@/lib/client/copy-email';
  copyEmail();
</script>
