---
import type { GetStaticPaths } from 'astro';
import { render, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Chips from '@/components/Chips.astro';
import PostCard from '@/components/PostCard.astro';
import PrevNext from '@/components/PrevNext.astro';
import { href } from '@/lib/paths';
import { publishedPosts } from '@/lib/posts';
import { formatDate, readingTime } from '@/lib/format';
import { site } from '@/lib/site';
import { Icon } from 'astro-icon/components';

export const getStaticPaths: GetStaticPaths = async () => {
  const sorted = await publishedPosts();
  return sorted.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      /** Newer and older neighbours, plus four more for the tail list. */
      newer: sorted[i - 1] ?? null,
      older: sorted[i + 1] ?? null,
      more: sorted.filter((p) => p.id !== post.id).slice(0, 4),
    },
  }));
};

interface Props {
  post: CollectionEntry<'posts'>;
  newer: CollectionEntry<'posts'> | null;
  older: CollectionEntry<'posts'> | null;
  more: CollectionEntry<'posts'>[];
}

const { post, newer, older, more } = Astro.props as Props;
const { Content, headings } = await render(post);
const d = post.data;
const minutes = d.readingTime ?? readingTime(post.body);
const shareUrl = new URL(href(`/writing/${post.id}`), Astro.site ?? 'https://smr.et').toString();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  author: { '@type': 'Person', name: site.name, url: 'https://www.linkedin.com/in/samu-el/' },
  publisher: { '@type': 'Person', name: site.name },
  mainEntityOfPage: { '@type': 'WebPage', '@id': shareUrl },
  keywords: d.tags.join(', '),
};

/** Only h2s make the contents list; deeper levels add noise, not navigation. */
const toc = headings.filter((h) => h.depth === 2);

const share = [
  {
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`,
    icon: 'simple-icons:linkedin',
    label: 'Share',
    external: true,
  },
  {
    href: `mailto:${site.email}?subject=${encodeURIComponent(`Re: ${d.title}`)}`,
    icon: 'lucide:mail',
    label: 'Reply',
    external: false,
  },
];
const eyebrow = 'meta';
---

<Layout
  title={d.title}
  description={d.description}
  path={`/writing/${post.id}`}
  type="article"
  publishedTime={d.pubDate}
  modifiedTime={d.updatedDate}
  tags={d.tags}
>
  <article>
    <header class="field-ink relative" style="view-transition-name:field">
      <div class="wrap pb-16 pt-10 lg:pb-24 lg:pt-14">
        <Breadcrumb to="/writing" label="All writing" />

        <div class="grid lg:grid-cols-12">
          <div class="lg:col-span-8">
            <h1 class="display-xl text-display-s" data-reveal style="--reveal-delay:60ms">
              {d.title}
            </h1>

            <p class="lead mt-8 text-muted" data-reveal style="--reveal-delay:120ms">
              {d.description}
            </p>

            <!-- Date, length and any update: separate items, no separator glyphs. -->
            <ul class="meta mt-8 flex flex-wrap gap-x-6 gap-y-1.5" data-reveal style="--reveal-delay:150ms">
              <li><time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate)}</time></li>
              <li>{minutes} min read</li>
              {d.updatedDate && <li>Updated {formatDate(d.updatedDate)}</li>}
            </ul>

            <div data-reveal style="--reveal-delay:160ms">
              <Chips items={d.tags} label="Tags" />
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="wrap sec">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-10">
        <div class="prose prose-lg lg:col-span-7">
          <Content />
        </div>

        <aside class="lg:col-span-4 lg:col-start-9">
          <div class="sticky top-24 space-y-8">
            {
              toc.length > 1 && (
                <nav aria-labelledby="toc-heading">
                  <h2 id="toc-heading" class={eyebrow}>
                    Contents
                  </h2>
                  <ol class="mt-4 space-y-2.5">
                    {toc.map((h, i) => (
                      <li>
                        <a
                          href={`#${h.slug}`}
                          class="toc-link flex gap-3 text-[0.875rem] leading-snug text-muted transition-colors hover:text-fg"
                          data-toc={h.slug}
                        >
                          <span class="toc-num tabular-nums text-subtle">{i + 1}</span>
                          <span>{h.text}</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </nav>
              )
            }

            {
              /* The site is one author's, so no byline card: just the two things a
                reader can do with a post. */
            }
            <div class="flex flex-wrap gap-2">
              {
                share.map((s) => (
                  <a
                    href={s.href}
                    target={s.external ? '_blank' : undefined}
                    rel={s.external ? 'noopener noreferrer' : undefined}
                    class="inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1.5 meta text-muted transition-colors hover:border-accent hover:text-accent"
                  >
                    <Icon name={s.icon} class="size-3" aria-hidden="true" />
                    {s.label}
                  </a>
                ))
              }
            </div>

            {
              more.length > 0 && (
                <div>
                  <h2 class={eyebrow}>More reading</h2>
                  <div class="mt-3">
                    {more.map((p) => (
                      <PostCard post={p} compact />
                    ))}
                  </div>
                </div>
              )
            }
          </div>
        </aside>
      </div>
    </div>

    <PrevNext
      base="/writing"
      label="More posts"
      back={older && { id: older.id, title: older.data.title }}
      forward={newer && { id: newer.id, title: newer.data.title }}
      backLabel="Older"
      forwardLabel="Newer"
      size="text-lg"
    />
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} is:inline />
</Layout>

<style>
  .toc-link.is-current,
  .toc-link.is-current .toc-num {
    color: var(--color-accent);
  }
</style>

<script>
  import { tableOfContents } from '@/lib/client/toc';
  tableOfContents();
</script>
