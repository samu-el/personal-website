---
import Layout from '@/layouts/Layout.astro';
import { navIndex } from '@/lib/posts';
import PostCard from '@/components/PostCard.astro';
import { publishedPosts } from '@/lib/posts';
import { href } from '@/lib/paths';
import { Icon } from 'astro-icon/components';
import PageHeader from '@/components/PageHeader.astro';

const posts = await publishedPosts();

const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
const title = 'Writing';
const description =
  'Essays by Samuel Mussie on hiring senior engineers, running distributed teams, shipping RAG systems, and why African-language AI is an unfunded problem rather than a hard one.';

const index = await navIndex('/writing');
---

<Layout {title} {description} path="/writing" noindex={posts.length === 0}>
  <PageHeader {index} label="Writing">
    Things I had to figure out
    <em class="block italic text-accent">and could not find written down.</em>
    <Fragment slot="aside">
      Hiring, handovers, and what breaks when AI features meet real users. No cadence, no newsletter
      — I publish when I have something I would defend in an argument.
      <div class="mt-5">
        <a href={href('/rss.xml')} class="btn btn-ghost !px-4 !py-2 !text-[0.8125rem]">
          <Icon name="lucide:rss" class="size-3.5" aria-hidden="true" />
          Subscribe via RSS
        </a>
      </div>
    </Fragment>
    {
      tags.length > 0 && (
        <ul
          slot="after"
          class="relative mt-12 flex flex-wrap items-center gap-2"
          aria-label="Topics"
          data-reveal
          style="--reveal-delay:220ms"
        >
          <li class="mr-1 font-mono text-2xs uppercase tracking-[0.14em] text-subtle">Topics</li>
          {tags.map((t) => (
            <li class="chip">{t}</li>
          ))}
        </ul>
      )
    }
  </PageHeader>

  <div class="wrap py-10 lg:py-20">
    <div class="grid lg:grid-cols-12">
      <div class="lg:col-span-10">
        {posts.map((post, i) => <PostCard post={post} index={i} />)}
      </div>
    </div>
    {
      posts.length === 0 && (
        <p class="py-16 text-muted">Nothing published yet. The drafts are worse than nothing.</p>
      )
    }
  </div>
</Layout>
