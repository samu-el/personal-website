---
/**
 * Live signals, fetched at build time and refreshed by a daily scheduled run.
 *
 * Every block here is conditional: when a feed cannot be reached the section is
 * simply absent rather than empty or stale. If none are reachable the page
 * still renders with its header, so the route never 404s.
 */
import Layout from '@/layouts/Layout.astro';
import { site } from '@/lib/site';
import { githubActivity, recentFilms, recentTracks } from '@/lib/feeds';
import { Icon } from 'astro-icon/components';
import FeedSection from '@/components/FeedSection.astro';
import NowPlaying from '@/components/NowPlaying.astro';
import PageHeader from '@/components/PageHeader.astro';
import Thumb from '@/components/Thumb.astro';

const [github, films, tracks] = await Promise.all([githubActivity(), recentFilms(), recentTracks()]);

/** "3 days ago": coarse on purpose, so a stale build cannot look precise. */
function ago(iso: string): string {
  const days = Math.floor((Date.now() - new Date(iso).getTime()) / 86_400_000);
  if (days <= 0) return 'today';
  if (days === 1) return 'yesterday';
  if (days < 30) return `${days} days ago`;
  const months = Math.round(days / 30);
  if (months < 12) return `${months} ${months === 1 ? 'month' : 'months'} ago`;
  const years = Math.round(days / 365);
  return `${years} ${years === 1 ? 'year' : 'years'} ago`;
}

/** Letterboxd stores ratings as decimals; whole stars, then a half where there is one. */
const stars = (rating: number) => [
  ...Array.from({ length: Math.floor(rating) }, () => 'lucide:star'),
  ...(rating % 1 ? ['lucide:star-half'] : []),
];

/** Rows arrive in sequence, but only the first handful are worth staggering. */
const stagger = (i: number) => `--reveal-delay:${Math.min(i, 6) * 60}ms`;

const meta = 'meta';
const stamp = `${meta} shrink-0 tabular-nums`;
const outbound = { target: '_blank', rel: 'noopener noreferrer' };
---

<Layout title="Now" description={`Recent public repository activity and recent films, from ${site.name}.`} path="/now">
  <PageHeader>Lately.</PageHeader>

  <NowPlaying />

  {
    github && github.recent.length > 0 && (
      <FeedSection title="Recently pushed" rule={false}>
        {github.recent.map((repo, i) => (
          <li data-reveal style={stagger(i)}>
            <a
              href={repo.url}
              {...outbound}
              class="group flex flex-col gap-2 py-4 transition-colors sm:flex-row sm:items-baseline sm:gap-6"
            >
              <span class="flex min-w-0 flex-1 items-baseline gap-3">
                <span class="truncate font-mono text-sm text-fg transition-colors group-hover:text-accent">
                  {repo.name}
                </span>
                <Icon
                  name="lucide:external-link"
                  class="size-3 shrink-0 text-subtle transition-transform duration-300 group-hover:text-accent"
                  aria-hidden="true"
                />
              </span>
              {repo.description && (
                <span class="min-w-0 flex-1 truncate text-[0.9375rem] text-muted sm:text-right">
                  {repo.description}
                </span>
              )}
              <span class:list={[meta, 'flex shrink-0 items-center gap-3']}>
                {repo.language && <span>{repo.language}</span>}
                <span class="tabular-nums">{ago(repo.pushedAt)}</span>
              </span>
            </a>
          </li>
        ))}
        <a slot="after" href="https://github.com/samu-el?tab=repositories" {...outbound} class="btn btn-ghost mt-8">
          <Icon name="simple-icons:github" class="size-4" aria-hidden="true" />
          All repositories
        </a>
      </FeedSection>
    )
  }

  {
    tracks && tracks.length > 0 && (
      <FeedSection title="Recently played">
        {tracks.map((track, i) => (
          <li data-reveal style={stagger(i)}>
            <a href={track.url} {...outbound} class="group flex items-center gap-4 py-3">
              <Thumb src={track.art} width={80} height={80} class="size-10" />
              <span class="flex min-w-0 flex-1 flex-col gap-0.5 sm:flex-row sm:items-baseline sm:gap-6">
                <span class="min-w-0 flex-1 truncate text-[1.0625rem] tracking-tight text-fg transition-colors group-hover:text-accent">
                  {track.title}
                </span>
                <span class="min-w-0 flex-1 truncate text-[0.9375rem] text-muted sm:text-right">{track.artist}</span>
              </span>
              <span class={stamp}>{ago(track.playedAt)}</span>
            </a>
          </li>
        ))}
      </FeedSection>
    )
  }

  {
    films && films.length > 0 && (
      <FeedSection title="Recently watched">
        <a
          slot="aside"
          href="https://letterboxd.com/rocin4nte/"
          {...outbound}
          class:list={[meta, 'hit flex items-center gap-2 transition-colors hover:text-accent']}
        >
          <Icon name="simple-icons:letterboxd" class="size-3.5" aria-hidden="true" />
          Letterboxd
          <Icon name="lucide:external-link" class="size-3" aria-hidden="true" />
        </a>
        {films.map((film, i) => (
          <li data-reveal style={stagger(i)}>
            <a href={film.url} {...outbound} class="group flex items-center gap-4 py-3">
              <Thumb src={film.poster} width={60} height={90} class="h-[3.375rem] w-9" />
              <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-4 gap-y-1.5">
                <span class="display text-title text-fg transition-colors group-hover:text-accent">{film.title}</span>
                {film.year && <span class="meta tabular-nums">{film.year}</span>}
                {film.rewatch && <span class="chip">Rewatch</span>}
                <span class="ml-auto flex items-center gap-4">
                  {film.rating !== null && (
                    <span
                      class="flex items-center gap-0.5 text-accent"
                      role="img"
                      aria-label={`${film.rating} out of 5`}
                    >
                      {stars(film.rating).map((icon) => (
                        <Icon is:inline name={icon} class="size-4 [&_path]:fill-current" aria-hidden="true" />
                      ))}
                    </span>
                  )}
                  <span class={stamp}>{ago(film.watchedAt)}</span>
                </span>
              </span>
            </a>
          </li>
        ))}
      </FeedSection>
    )
  }

  {
    !github && !films && !tracks && (
      <section class="scroll-mt-24">
        <div class="wrap py-10 lg:py-20">
          <p class="text-[1.0625rem] text-muted">No feed could be reached at build time.</p>
        </div>
      </section>
    )
  }
</Layout>
