---
import Layout from '@/layouts/Layout.astro';
import { visibleNav } from '@/lib/posts';
import { href } from '@/lib/paths';
import { Icon } from 'astro-icon/components';

const items = await visibleNav();
---

<Layout title="Not found" description="That page does not exist." path="/404" noindex>
  <section class="field-ink relative">
    <div class="wrap grid gap-12 py-16 lg:grid-cols-12 lg:items-end lg:gap-8 lg:py-28">
      <h1 class="display-xl text-[clamp(4rem,11vw,10rem)] lg:col-span-6">Not found.</h1>

      <!-- Every page that does exist: the way on is the answer to the error. -->
      <nav aria-label="All pages" class="lg:col-span-5 lg:col-start-8">
        <ul class="ledger sm:grid sm:grid-cols-2">
          {
            items.map((item, i) => (
              <li class:list={[i % 2 === 0 ? 'sm:border-r sm:pr-6' : 'sm:pl-6']}>
                <a href={href(item.href)} class="group flex items-baseline gap-3 py-4 transition-colors">
                  <span class="display text-title transition-colors group-hover:text-accent">{item.label}</span>
                  <Icon name="lucide:arrow-right" class="ml-auto size-4 self-center text-subtle" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</Layout>
