---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Chips from '@/components/Chips.astro';
import PrevNext from '@/components/PrevNext.astro';
import PreviewFrame from '@/components/PreviewFrame.astro';
import { Icon } from 'astro-icon/components';
import { tone } from '@/lib/status';

export const getStaticPaths: GetStaticPaths = async () => {
  // Hidden projects get no detail page, so nothing links into them and they
  // stay out of the sitemap.
  const projects = await getCollection('projects', ({ data }) => !data.hidden && (import.meta.env.DEV || !data.draft));
  const sorted = projects.sort((a, b) => b.data.weight - a.data.weight);
  return sorted.map((project, i) => ({
    params: { id: project.id },
    props: { project, prev: sorted[i - 1] ?? null, next: sorted[i + 1] ?? null },
  }));
};

interface Props {
  project: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'> | null;
  next: CollectionEntry<'projects'> | null;
}

const { project, prev, next } = Astro.props as Props;
const { Content } = await render(project);
const d = project.data;

/** Only a project that is actually up gets the live dot. */
const isLive = d.status === 'Live' || d.status === 'Ongoing';

/* Built by spreading rather than filtering a cast: a generic type argument
   anywhere in frontmatter stops Astro finding `interface Props`. */
const links = [
  ...(d.demo ? [{ href: d.demo, icon: 'lucide:external-link', label: 'View live', cls: 'btn-primary' }] : []),
  ...(d.repo
    ? [{ href: d.repo, icon: 'simple-icons:github', label: 'Source', cls: 'btn-ghost bg-bg hover:bg-surface-2' }]
    : []),
];

const eyebrow = 'meta';
/** Paper behind each line of header text, so the column rules run under the
 *  words instead of through them. */
const onPaper = 'bg-bg [box-decoration-break:clone]';
---

<Layout title={d.title} description={d.blurb} path={`/work/${project.id}`} type="article" tags={d.tags}>
  <article>
    <header class="relative overflow-hidden border-b border-line">
      <div class="pointer-events-none absolute inset-0 grid-lines opacity-60" aria-hidden="true"></div>
      <div class="wrap relative py-10 lg:py-20">
        <Breadcrumb to="/work" label="All work" />

        <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
          <div class="lg:col-span-7">
            <p class:list={['flex w-fit flex-wrap items-center gap-x-3 gap-y-1.5', onPaper]} data-reveal>
              <span class="meta">
                {d.kind}
              </span>
              <span class="text-line-strong" aria-hidden="true">·</span>
              <span class="font-mono text-2xs tracking-wide text-subtle">{d.period}</span>
              <span class="text-line-strong" aria-hidden="true">·</span>
              <span class:list={['meta inline-flex items-center gap-1.5', tone(d.status)]}>
                {
                  isLive && (
                    <span class="relative flex size-1.5">
                      <span class="absolute inline-flex size-full animate-ping rounded-full bg-jade opacity-60" />
                      <span class="relative inline-flex size-1.5 rounded-full bg-jade" />
                    </span>
                  )
                }
                {d.status}
              </span>
            </p>

            <!-- Outranks the footer's "Reach out." at every width. -->
            <h1
              class="display-hero mt-6 text-[clamp(2.75rem,7.6vw,6rem)]"
              data-reveal
              style={`--reveal-delay:60ms;view-transition-name:project-${project.id}`}
            >
              <span class={onPaper}>{d.title}</span>
            </h1>

            <p
              class="mt-6 max-w-2xl text-[1.0625rem] leading-relaxed text-muted"
              data-reveal
              style="--reveal-delay:120ms"
            >
              <span class={onPaper}>{d.blurb}</span>
            </p>

            <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--reveal-delay:180ms">
              {
                links.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener noreferrer" class:list={['btn', l.cls]}>
                    <Icon name={l.icon} class="size-4" aria-hidden="true" />
                    {l.label}
                  </a>
                ))
              }
              {
                !d.repo && d.repoPrivate && (
                  <span class:list={['inline-flex items-center gap-2 meta', onPaper]}>
                    <Icon name="lucide:lock" class="size-3.5" aria-hidden="true" />
                    Private source
                  </span>
                )
              }
            </div>
          </div>

          <!-- A div: an aside inside main is not a top-level landmark. -->
          <div class="lg:col-span-4 lg:col-start-9" data-reveal style="--reveal-delay:240ms">
            <div class="card rounded-lg p-6">
              <dl class="space-y-4 text-sm">
                <div>
                  <dt class={eyebrow}>Role</dt>
                  <dd class="mt-1.5 leading-snug text-fg">{d.role}</dd>
                </div>
                {
                  d.stats.length > 0 && (
                    <>
                      <div class="rule" />
                      {d.stats.map((s) => (
                        <div class="flex justify-between gap-4">
                          <dt class="text-subtle">{s.label}</dt>
                          <dd class="text-right text-fg">{s.value}</dd>
                        </div>
                      ))}
                    </>
                  )
                }
                {
                  [
                    { title: 'Stack', items: d.stack },
                    { title: 'Tags', items: d.tags },
                  ].map(
                    ({ title, items }) =>
                      items.length > 0 && (
                        <>
                          <div class="rule" />
                          <div>
                            <dt class={eyebrow}>{title}</dt>
                            <dd>
                              <Chips items={items} class="mt-3" />
                            </dd>
                          </div>
                        </>
                      ),
                  )
                }
              </dl>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Between the facts and the write-up: by here the reader knows what the
         thing is and has not yet been asked to read about it. -->
    <div class="wrap pt-10 lg:pt-16">
      <div data-reveal>
        <PreviewFrame {project} eager sizes="(min-width: 1280px) 1120px, 90vw" />
      </div>
    </div>

    <div class="wrap py-10 lg:py-20">
      <div class="grid lg:grid-cols-12">
        <div class="prose lg:col-span-7">
          <Content />
        </div>
      </div>
    </div>

    <PrevNext
      base="/work"
      label="More work"
      back={prev && { id: prev.id, title: prev.data.title }}
      forward={next && { id: next.id, title: next.data.title }}
      backLabel="Previous"
      forwardLabel="Next"
    />
  </article>
</Layout>
