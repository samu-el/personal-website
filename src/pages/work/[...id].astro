---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Chips from '@/components/Chips.astro';
import PrevNext from '@/components/PrevNext.astro';
import PreviewFrame from '@/components/PreviewFrame.astro';
import { Icon } from 'astro-icon/components';
import { tone } from '@/lib/status';

export const getStaticPaths: GetStaticPaths = async () => {
  // Hidden projects get no detail page, so nothing links into them and they
  // stay out of the sitemap.
  const projects = await getCollection('projects', ({ data }) => !data.hidden && (import.meta.env.DEV || !data.draft));
  const sorted = projects.sort((a, b) => b.data.weight - a.data.weight);
  return sorted.map((project, i) => ({
    params: { id: project.id },
    props: { project, prev: sorted[i - 1] ?? null, next: sorted[i + 1] ?? null },
  }));
};

interface Props {
  project: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'> | null;
  next: CollectionEntry<'projects'> | null;
}

const { project, prev, next } = Astro.props as Props;
const { Content } = await render(project);
const d = project.data;
const phone = d.device === 'phone';

/* Built by spreading rather than filtering a cast: a generic type argument
   anywhere in frontmatter stops Astro finding `interface Props`. */
const links = [
  ...(d.demo ? [{ href: d.demo, icon: 'lucide:external-link', label: 'View live', cls: 'btn-primary' }] : []),
  ...(d.repo ? [{ href: d.repo, icon: 'simple-icons:github', label: 'Source', cls: 'btn-ghost' }] : []),
];
---

<Layout title={d.title} description={d.blurb} path={`/work/${project.id}`} type="article" tags={d.tags}>
  <article>
    <!-- Banner: the name, what it is, and the way to it. The facts wait beside
         the write-up, where they are read. -->
    <header class="field-ink relative" style="view-transition-name:field">
      <div class="wrap pb-16 pt-10 lg:pb-24 lg:pt-14">
        <Breadcrumb to="/work" label="All work" />

        <div class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-8">
          <div class="lg:col-span-8">
            <h1
              class="display-xl text-display"
              data-reveal
              style={`--reveal-delay:60ms;view-transition-name:project-${project.id}`}
            >
              {d.title}
            </h1>

            <p class="lead mt-8 text-muted" data-reveal style="--reveal-delay:120ms">
              {d.blurb}
            </p>

            {
              links.length > 0 && (
                <div class="mt-10 flex flex-wrap gap-3" data-reveal style="--reveal-delay:180ms">
                  {links.map((l) => (
                    <a href={l.href} target="_blank" rel="noopener noreferrer" class:list={['btn', l.cls]}>
                      <Icon name={l.icon} class="size-4" aria-hidden="true" />
                      {l.label}
                    </a>
                  ))}
                </div>
              )
            }
          </div>

          <!-- Kind, period and status: three ruled lines, no separator glyphs. -->
          <dl class="ledger text-[0.9375rem] lg:col-span-3 lg:col-start-10" data-reveal style="--reveal-delay:240ms">
            <div class="flex justify-between gap-4 py-3">
              <dt class="sr-only">Kind</dt>
              <dd class="text-fg">{d.kind}</dd>
            </div>
            <div class="flex justify-between gap-4 py-3">
              <dt class="sr-only">Period</dt>
              <dd class="tabular-nums text-fg">{d.period}</dd>
            </div>
            <div class="flex justify-between gap-4 py-3">
              <dt class="sr-only">Status</dt>
              <dd class={tone(d.status)}>{d.status}</dd>
            </div>
          </dl>
        </div>
      </div>
    </header>

    <!-- The product, at the width of the page: the reader sees the thing
         before being asked to read about it. -->
    {
      !phone && (
        <section class="wrap pt-12 lg:pt-16" aria-label={`${d.title}, running`}>
          <div data-reveal>
            <PreviewFrame {project} eager sizes="(min-width: 1440px) 1312px, 92vw" />
          </div>
        </section>
      )
    }

    <!-- A phone capture is held beside the write-up instead: alone across the
         page it would stand in a band of nothing. -->
    <section class="wrap sec">
      <div class="grid gap-14 lg:grid-cols-12 lg:gap-8">
        {
          phone && (
            <figure class="lg:col-span-3">
              <div class="lg:sticky lg:top-28" data-reveal>
                <PreviewFrame {project} eager />
              </div>
            </figure>
          )
        }
        <div class:list={['prose prose-lg', phone ? 'lg:col-span-6' : 'lg:col-span-7']}>
          <Content />
        </div>

        <!-- The facts, held beside the write-up. A div: an aside inside main
             is not a top-level landmark. -->
        <div class:list={[phone ? 'lg:col-span-3' : 'lg:col-span-4 lg:col-start-9']}>
          <dl class="ledger text-[0.9375rem] lg:sticky lg:top-28">
            <div class="flex justify-between gap-4 py-3">
              <dt class="text-subtle">Role</dt>
              <dd class="text-right text-fg">{d.role}</dd>
            </div>
            {
              d.stats.map((s) => (
                <div class="flex justify-between gap-4 py-3">
                  <dt class="text-subtle">{s.label}</dt>
                  <dd class="text-right text-fg">{s.value}</dd>
                </div>
              ))
            }
            {
              [
                { title: 'Stack', items: d.stack },
                { title: 'Tags', items: d.tags },
              ].map(
                ({ title, items }) =>
                  items.length > 0 && (
                    <div class="py-4">
                      <dt class="text-subtle">{title}</dt>
                      <dd>
                        <Chips items={items} class="mt-3" />
                      </dd>
                    </div>
                  ),
              )
            }
          </dl>
        </div>
      </div>
    </section>

    <PrevNext
      base="/work"
      label="More work"
      back={prev && { id: prev.id, title: prev.data.title }}
      forward={next && { id: next.id, title: next.data.title }}
      backLabel="Previous"
      forwardLabel="Next"
    />
  </article>
</Layout>
