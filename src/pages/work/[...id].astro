---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { href } from '@/lib/paths';
import { Icon } from 'astro-icon/components';

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getCollection(
    'projects',
    ({ data }) => import.meta.env.DEV || !data.draft,
  );
  const sorted = projects.sort((a, b) => b.data.weight - a.data.weight);

  return sorted.map((project, i) => ({
    params: { id: project.id },
    props: {
      project,
      prev: sorted[i - 1] ?? null,
      next: sorted[i + 1] ?? null,
    },
  }));
};

interface Props {
  project: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'> | null;
  next: CollectionEntry<'projects'> | null;
}

const { project, prev, next } = Astro.props as Props;
const { Content } = await render(project);
const d = project.data;

const statusTone: Record<string, string> = {
  Live: 'text-jade',
  Ongoing: 'text-jade',
  Shipped: 'text-muted',
  Experiment: 'text-accent',
  Archived: 'text-subtle',
};
---

<Layout
  title={d.title}
  description={d.blurb}
  path={`/work/${project.id}`}
  type="article"
  tags={d.tags}
>
  <article>
    <!-- ── Header ─────────────────────────────────────────────────── -->
    <header class="relative overflow-hidden border-b border-line">
      <div class="pointer-events-none absolute inset-0 grid-lines opacity-60" aria-hidden="true">
      </div>
      <div class="wrap relative py-14 lg:py-20">
        <nav aria-label="Breadcrumb" class="mb-10">
          <a
            href={href('/work')}
            class="group inline-flex items-center gap-2 font-mono text-2xs uppercase tracking-[0.12em] text-subtle transition-colors hover:text-fg"
          >
            <Icon
              name="lucide:arrow-left"
              class="size-3 transition-transform duration-300 group-hover:-translate-x-0.5"
              aria-hidden="true"
            />
            All work
          </a>
        </nav>

        <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
          <div class="lg:col-span-7">
            <p class="flex flex-wrap items-center gap-x-3 gap-y-1.5" data-reveal>
              <span class="font-mono text-2xs uppercase tracking-[0.12em] text-subtle">
                {d.kind}
              </span>
              <span class="text-line-strong" aria-hidden="true">·</span>
              <span class="font-mono text-2xs tracking-wide text-subtle">{d.period}</span>
              <span class="text-line-strong" aria-hidden="true">·</span>
              <span
                class:list={[
                  'inline-flex items-center gap-1.5 font-mono text-2xs uppercase tracking-[0.1em]',
                  statusTone[d.status] ?? 'text-muted',
                ]}
              >
                {
                  (d.status === 'Live' || d.status === 'Ongoing') && (
                    <span class="relative flex size-1.5">
                      <span class="absolute inline-flex size-full animate-ping rounded-full bg-jade opacity-60" />
                      <span class="relative inline-flex size-1.5 rounded-full bg-jade" />
                    </span>
                  )
                }
                {d.status}
              </span>
            </p>

            <h1
              class="display mt-6 text-[clamp(2.4rem,6.6vw,4.25rem)]"
              data-reveal
              style="--reveal-delay:60ms"
            >
              {d.title}
            </h1>

            <p
              class="mt-6 max-w-2xl text-[1.0625rem] leading-relaxed text-muted"
              data-reveal
              style="--reveal-delay:120ms"
            >
              {d.blurb}
            </p>

            <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--reveal-delay:180ms">
              {
                d.demo && (
                  <a
                    href={d.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-primary"
                  >
                    <Icon name="lucide:external-link" class="size-4" aria-hidden="true" />
                    View live
                  </a>
                )
              }
              {
                d.repo && (
                  <a href={d.repo} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
                    <Icon name="simple-icons:github" class="size-4" aria-hidden="true" />
                    Source
                  </a>
                )
              }
            </div>
          </div>

          <!-- Fact panel -->
          <aside class="lg:col-span-4 lg:col-start-9" data-reveal style="--reveal-delay:240ms">
            <div class="card rounded-lg p-6">
              <dl class="space-y-4 text-sm">
                <div>
                  <dt class="font-mono text-2xs uppercase tracking-[0.14em] text-subtle">Role</dt>
                  <dd class="mt-1.5 leading-snug text-fg">{d.role}</dd>
                </div>
                {
                  d.stats.length > 0 && (
                    <>
                      <div class="rule" />
                      {d.stats.map((s) => (
                        <div class="flex justify-between gap-4">
                          <dt class="text-subtle">{s.label}</dt>
                          <dd class="text-right text-fg">{s.value}</dd>
                        </div>
                      ))}
                    </>
                  )
                }
                {
                  d.stack.length > 0 && (
                    <>
                      <div class="rule" />
                      <div>
                        <dt class="font-mono text-2xs uppercase tracking-[0.14em] text-subtle">
                          Stack
                        </dt>
                        <dd class="mt-3">
                          <ul class="flex flex-wrap gap-1.5">
                            {d.stack.map((s) => (
                              <li class="chip">{s}</li>
                            ))}
                          </ul>
                        </dd>
                      </div>
                    </>
                  )
                }
                {
                  d.tags.length > 0 && (
                    <>
                      <div class="rule" />
                      <div>
                        <dt class="font-mono text-2xs uppercase tracking-[0.14em] text-subtle">
                          Tags
                        </dt>
                        <dd class="mt-3">
                          <ul class="flex flex-wrap gap-1.5">
                            {d.tags.map((t) => (
                              <li class="chip">{t}</li>
                            ))}
                          </ul>
                        </dd>
                      </div>
                    </>
                  )
                }
              </dl>
            </div>
          </aside>
        </div>
      </div>
    </header>

    <!-- ── Body ───────────────────────────────────────────────────── -->
    <div class="wrap py-16 lg:py-20">
      <div class="grid lg:grid-cols-12">
        <div class="prose lg:col-span-7">
          <Content />
        </div>
      </div>
    </div>

    <!-- ── Prev / next ────────────────────────────────────────────── -->
    <nav aria-label="More work" class="border-t border-line">
      <div class="wrap grid gap-px py-0 sm:grid-cols-2">
        {
          prev ? (
            <a
              href={href(`/work/${prev.id}`)}
              class="group flex flex-col justify-between gap-4 border-b border-line py-8 sm:border-b-0 sm:border-r sm:pr-8"
            >
              <span class="inline-flex items-center gap-2 font-mono text-2xs uppercase tracking-[0.12em] text-subtle">
                <Icon
                  name="lucide:arrow-left"
                  class="size-3 transition-transform duration-300 group-hover:-translate-x-0.5"
                  aria-hidden="true"
                />
                Previous
              </span>
              <span class="text-xl font-medium tracking-tight transition-colors group-hover:text-accent">
                {prev.data.title}
              </span>
            </a>
          ) : (
            <div class="hidden sm:block" />
          )
        }
        {
          next && (
            <a
              href={href(`/work/${next.id}`)}
              class="group flex flex-col items-start justify-between gap-4 py-8 sm:items-end sm:pl-8 sm:text-right"
            >
              <span class="inline-flex items-center gap-2 font-mono text-2xs uppercase tracking-[0.12em] text-subtle">
                Next
                <Icon
                  name="lucide:arrow-right"
                  class="size-3 transition-transform duration-300 group-hover:translate-x-0.5"
                  aria-hidden="true"
                />
              </span>
              <span class="text-xl font-medium tracking-tight transition-colors group-hover:text-accent">
                {next.data.title}
              </span>
            </a>
          )
        }
      </div>
    </nav>
  </article>
</Layout>
