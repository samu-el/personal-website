---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { Icon } from 'astro-icon/components';
import { href } from '@/lib/paths';

const isPublished = (d: { draft?: boolean }) => import.meta.env.DEV || !d.draft;

const all = (await getCollection('projects', ({ data }) => isPublished(data))).sort(
  (a, b) => b.data.weight - a.data.weight,
);

/** The showcase. Everything else is deliberately kept out of it. */
const showcased = all.filter((p) => !p.data.hidden);

/**
 * Hidden work still worth acknowledging: one line each, linking straight to
 * the repository. Anything without a public repo stays off the page entirely.
 */
const alsoPublic = all.filter((p) => p.data.hidden && p.data.repo);

const title = 'Work';
const description =
  'fantasy.et — Fantasy Premier League tooling by Samuel Mussie: a Next.js web app and a React Native companion sharing one data layer against a live public API.';
---

<Layout {title} {description} path="/work">
  <section class="relative overflow-hidden border-b border-line">
    <div class="pointer-events-none absolute inset-0 grid-lines opacity-60" aria-hidden="true">
    </div>
    <div class="wrap relative py-16 lg:py-24">
      <p class="eyebrow" data-reveal>03 &nbsp;Work</p>
      <div class="mt-7 grid gap-10 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-7">
          <h1
            class="display text-[clamp(2.4rem,6.6vw,4.25rem)]"
            data-reveal
            style="--reveal-delay:60ms"
          >
            One project I will happily
            <em class="block italic text-accent">talk about for an hour.</em>
          </h1>
        </div>
        <div class="lg:col-span-4 lg:col-start-9 lg:pt-3">
          <p class="text-base leading-relaxed text-muted" data-reveal style="--reveal-delay:120ms">
            Client work ships under someone else&rsquo;s name and stays there. So rather than a grid
            of thumbnails, here is the one thing that is mine end to end, in the detail it actually
            deserves.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap py-16 lg:py-20">
    <div class="grid gap-5">
      {showcased.map((p) => <ProjectCard project={p} index={0} feature />)}
    </div>

    <!-- Everything else: acknowledged, not showcased. -->
    {
      alsoPublic.length > 0 && (
        <section class="mt-20 border-t border-line pt-12 lg:mt-28">
          <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
            <div class="lg:col-span-4">
              <p class="eyebrow" data-reveal>
                Also public
              </p>
              <p
                class="mt-4 max-w-sm text-[0.9375rem] leading-relaxed text-muted"
                data-reveal
                style="--reveal-delay:60ms"
              >
                A decade of smaller things — bots, tools, two mobile apps, a URL shortener built
                twice. Not written up, but the commit history is there if you want it.
              </p>
            </div>
            <div class="lg:col-span-8">
              <ul class="border-t border-line">
                {alsoPublic.map((p, i) => (
                  <li>
                    <a
                      href={p.data.repo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group flex items-baseline gap-4 border-b border-line py-3.5"
                      data-reveal
                      style={`--reveal-delay:${Math.min(i, 8) * 40}ms`}
                    >
                      <span class="w-28 shrink-0 whitespace-nowrap font-mono text-2xs tracking-wide text-subtle">
                        {p.data.period}
                      </span>
                      <span class="text-[0.9375rem] tracking-tight text-fg transition-colors group-hover:text-accent">
                        {p.data.title}
                      </span>
                      <span class="ml-auto hidden shrink-0 font-mono text-2xs text-subtle sm:block">
                        {p.data.stack[0] ?? p.data.kind}
                      </span>
                      <Icon
                        name="lucide:arrow-up-right"
                        class="size-3.5 shrink-0 self-center text-subtle transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
                        aria-hidden="true"
                      />
                    </a>
                  </li>
                ))}
              </ul>
              <a
                href="https://github.com/samu-el?tab=repositories"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-ghost mt-8"
              >
                <Icon name="simple-icons:github" class="size-4" aria-hidden="true" />
                Everything on GitHub
              </a>
            </div>
          </div>
        </section>
      )
    }

    <div class="mt-16 border-t border-line pt-10">
      <p class="max-w-2xl text-[0.9375rem] leading-relaxed text-muted">
        If you want to talk about the client work that is not on this page —{' '}
        <a href={href('/contact')} class="link">ask me</a>. I can walk you through the architecture
        without naming anyone, or put you in touch with someone I have built for.
      </p>
    </div>
  </div>
</Layout>
