---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { navIndex } from '@/lib/posts';
import ProjectShowcase from '@/components/ProjectShowcase.astro';
import { Icon } from 'astro-icon/components';
import PageHeader from '@/components/PageHeader.astro';

const isPublished = (d: { draft?: boolean }) => import.meta.env.DEV || !d.draft;

const all = (await getCollection('projects', ({ data }) => isPublished(data))).sort(
  (a, b) => b.data.weight - a.data.weight,
);

/** The showcase. Everything else is deliberately kept out of it. */
const showcased = all.filter((p) => !p.data.hidden);

const title = 'Work';
const description =
  'Selected work by Samuel Mussie: fantasy.et, a Fantasy Premier League web app and mobile companion in TypeScript, Next.js and React Native.';

const index = await navIndex('/work');
---

<Layout {title} {description} path="/work">
  <PageHeader {index} label="Work">
    Selected <em class="italic text-accent">work.</em>
    <Fragment slot="aside">
      Feel free to reach out about any of the projects I&rsquo;ve worked on.
    </Fragment>
  </PageHeader>

  <div class="wrap py-12 lg:py-24">
    <!-- Rows rather than cards, separated by a rule, so each project gets
         room for a screenshot instead of competing in a stack. -->
    <div class="grid gap-14 lg:gap-24">
      {showcased.map((p, i) => <ProjectShowcase project={p} index={i} />)}
    </div>

    <!-- Everything else lives on GitHub rather than being re-listed here. -->
    <section class="mt-12 border-t border-line pt-10 lg:mt-28 lg:pt-12">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-4">
          <p class="eyebrow" data-reveal>Other repositories</p>
        </div>
        <div class="lg:col-span-7">
          <p
            class="max-w-xl text-[0.9375rem] leading-relaxed text-muted"
            data-reveal
            style="--reveal-delay:60ms"
          >
            More projects — bots, tools, mobile apps and experiments — are on GitHub.
          </p>
          <a
            href="https://github.com/samu-el?tab=repositories"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost mt-7"
            data-reveal
            style="--reveal-delay:120ms"
          >
            <Icon name="simple-icons:github" class="size-4" aria-hidden="true" />
            Explore on GitHub
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
