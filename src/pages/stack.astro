---
import Layout from '@/layouts/Layout.astro';
import { stack } from '@/data/stack';
import { href } from '@/lib/paths';
import { Icon } from 'astro-icon/components';

const title = 'Stack';
const description =
  'The languages, frameworks and tools Samuel Mussie actually reaches for — ordered by how often, not by how impressive.';
const total = stack.reduce((n, g) => n + g.items.length, 0);
---

<Layout {title} {description} path="/stack">
  <section class="relative overflow-hidden border-b border-line">
    <div class="pointer-events-none absolute inset-0 grid-lines opacity-60" aria-hidden="true">
    </div>
    <div class="wrap relative py-16 lg:py-24">
      <p class="eyebrow" data-reveal>05 &nbsp;Stack</p>
      <div class="mt-7 grid gap-10 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-7">
          <h1
            class="display text-[clamp(2.4rem,6.6vw,4.25rem)]"
            data-reveal
            style="--reveal-delay:60ms"
          >
            What I reach for,<br class="hidden lg:block" />
            <em class="italic text-accent">and why it is usually boring.</em>
          </h1>
        </div>
        <div class="lg:col-span-4 lg:col-start-9 lg:pt-3">
          <p class="text-base leading-relaxed text-muted" data-reveal style="--reveal-delay:120ms">
            {total} tools across six groups. Spend the novelty budget where a user can feel it; everything
            underneath should be the version a new engineer can debug in their first week.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap py-16 lg:py-20">
    <div class="space-y-16 lg:space-y-24">
      {
        stack.map((group) => (
          <section class="grid gap-8 lg:grid-cols-12 lg:gap-10">
            <div class="lg:col-span-4">
              <div class="lg:sticky lg:top-24">
                <p class="eyebrow" data-reveal>
                  <span class="text-accent">{group.index}</span>
                  {group.title}
                </p>
                <p
                  class="mt-4 max-w-sm text-[0.9375rem] leading-relaxed text-muted"
                  data-reveal
                  style="--reveal-delay:60ms"
                >
                  {group.blurb}
                </p>
              </div>
            </div>

            <div class="lg:col-span-8">
              <ul class="grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2">
                {group.items.map((item, i) => (
                  <li
                    class="group flex items-start gap-3.5 bg-surface p-5 transition-colors duration-300 hover:bg-surface-2"
                    data-reveal
                    style={`--reveal-delay:${Math.min(i, 6) * 50}ms`}
                  >
                    {item.icon && (
                      <Icon
                        name={item.icon}
                        class="mt-0.5 size-[1.15rem] shrink-0 text-subtle transition-colors duration-300 group-hover:text-accent"
                        aria-hidden="true"
                      />
                    )}
                    <div class="min-w-0">
                      <p class="text-[0.9375rem] font-medium tracking-tight">{item.name}</p>
                      {item.note && (
                        <p class="mt-1 text-[0.8125rem] leading-snug text-subtle">{item.note}</p>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        ))
      }
    </div>

    <!-- How this site is built -->
    <section class="mt-20 border-t border-line pt-12 lg:mt-28">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-4">
          <p class="eyebrow" data-reveal>07 &nbsp;This site</p>
        </div>
        <div class="lg:col-span-7">
          <div class="prose" data-reveal style="--reveal-delay:60ms">
            <p>
              Astro with content collections, Tailwind, and no client framework — the JavaScript on
              this page is a theme toggle, a mobile menu, a scroll observer and a clock. Everything
              else is HTML that was already finished when it arrived.
            </p>
            <p>
              Statically built, deployed by GitHub Actions to GitHub Pages, and <a
                href="https://github.com/samu-el/personal-website"
                target="_blank"
                rel="noopener noreferrer">open source</a
              >. Type scale, colour tokens and dark mode are defined once in one stylesheet, which
              is the only way a design system survives contact with a second contributor.
            </p>
            <p>
              If you want the same discipline applied to something of yours, <a
                href={href('/contact')}>that is the job</a
              >.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
