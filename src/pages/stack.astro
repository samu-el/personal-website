---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { navIndex } from '@/lib/posts';
import { stack } from '@/data/stack';
import { Icon } from 'astro-icon/components';

const title = 'Stack';
const description =
  'Languages, frameworks and tools used by Samuel Mussie in production: TypeScript, Python, React, Next.js, PostgreSQL, Flutter, AWS.';

const index = await navIndex('/stack');
---

<Layout {title} {description} path="/stack">
  <PageHeader {index} label="Stack">
    Languages, frameworks
    <em class="block italic text-accent">and tools.</em>
    <Fragment slot="aside">Technologies I&rsquo;ve worked with across my career.</Fragment>
  </PageHeader>

  <!-- A specimen sheet: each group is a ruled row, its index and title held
       on the left while the items run in two ruled columns on the right. -->
  <div class="wrap py-6 lg:py-10">
    <div class="ledger">
      {
        stack.map((group) => (
          <section class="relative grid gap-8 py-10 lg:grid-cols-12 lg:gap-8 lg:py-16">
            <span class="rail-index rail-index--left lg:!text-[9rem]" aria-hidden="true">
              {group.index}
            </span>

            <div class="relative lg:col-span-4">
              <div class="lg:sticky lg:top-24">
                <p class="eyebrow" data-reveal>
                  <span class="text-accent">{group.index}</span>
                  {group.title}
                </p>
                <h2
                  class="display mt-4 text-[clamp(1.75rem,3.2vw,2.4rem)]"
                  data-reveal
                  style="--reveal-delay:40ms"
                >
                  {group.title}
                </h2>
                <p
                  class="mt-3 max-w-sm text-[0.9375rem] leading-relaxed text-muted"
                  data-reveal
                  style="--reveal-delay:80ms"
                >
                  {group.blurb}
                </p>
              </div>
            </div>

            <ul class="relative grid sm:grid-cols-2 lg:col-span-8">
              {group.items.map((item, i) => (
                <li
                  class:list={[
                    'group flex items-center gap-4 border-b border-line py-4',
                    // Two ruled columns from sm up: odd cells carry the middle
                    // hairline and even ones take the matching indent, so the
                    // grid reads as one table. The top rule comes from .ledger.
                    i % 2 === 0 ? 'sm:border-r sm:pr-6' : 'sm:pl-6',
                    // No bottom rule under the last row, whichever column it is.
                    i >= group.items.length - (group.items.length % 2 === 0 ? 2 : 1) &&
                      'sm:border-b-0',
                    i === group.items.length - 1 && 'border-b-0',
                  ]}
                  data-reveal
                  style={`--reveal-delay:${Math.min(i, 6) * 40}ms`}
                >
                  {item.icon && (
                    <Icon
                      name={item.icon}
                      class="size-5 shrink-0 text-subtle transition-colors duration-300 group-hover:text-accent"
                      aria-hidden="true"
                    />
                  )}
                  <span class="min-w-0 flex-1">
                    <p class="text-[0.9375rem] font-medium tracking-tight text-fg">{item.name}</p>
                    {item.note && (
                      <p class="mt-0.5 font-mono text-2xs tracking-wide text-subtle">{item.note}</p>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <!-- How this site is built -->
    <section class="mt-12 border-t border-line pt-12 lg:mt-20 lg:pt-16">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-4">
          <p class="eyebrow" data-reveal>This site</p>
        </div>
        <div class="lg:col-span-7">
          <div class="prose" data-reveal style="--reveal-delay:60ms">
            <p>
              Astro with content collections, Tailwind CSS, and no client framework. The JavaScript
              on a page is a theme toggle, a mobile menu, a command palette, a scroll observer and a
              clock; there is no JS bundle. Fonts are self-hosted.
            </p>
            <p>Built to static HTML and deployed by GitHub Actions.</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
