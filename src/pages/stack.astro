---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { stack } from '@/data/stack';
import { Icon } from 'astro-icon/components';

const title = 'Stack';
const description =
  'Languages, frameworks and tools used by Samuel Mussie in production: TypeScript, Python, React, Next.js, PostgreSQL, Flutter, AWS.';
---

<Layout {title} {description} path="/stack">
  <PageHeader>Languages, frameworks and tools.</PageHeader>

  <!-- A specimen sheet: each group is a ruled row, its title held on the
       left while the items run in two ruled columns on the right. -->
  <div class="wrap pb-[var(--section-gap)] pt-2">
    <div class="ledger">
      {
        stack.map((group) => (
          <section class="relative grid gap-8 py-12 lg:grid-cols-12 lg:gap-8 lg:py-20">
            <div class="relative lg:col-span-4">
              <div class="relative lg:sticky lg:top-28">
                <h2 class="display text-section" data-reveal>
                  {group.title}
                </h2>
              </div>
            </div>
            <ul class="relative grid sm:grid-cols-2 lg:col-span-8">
              {group.items.map((item, i) => (
                <li
                  class:list={[
                    'group flex items-center gap-4 border-b border-line py-4',
                    // Two ruled columns from sm up: odd cells carry the middle
                    // hairline and even ones take the matching indent, so the
                    // grid reads as one table. The top rule comes from .ledger.
                    i % 2 === 0 ? 'sm:border-r sm:pr-6' : 'sm:pl-6',
                    // No bottom rule under the last row, whichever column it is.
                    i >= group.items.length - (group.items.length % 2 === 0 ? 2 : 1) && 'sm:border-b-0',
                    i === group.items.length - 1 && 'border-b-0',
                  ]}
                  data-reveal
                  style={`--reveal-delay:${Math.min(i, 6) * 40}ms`}
                >
                  {item.icon && (
                    <Icon
                      name={item.icon}
                      class="size-5 shrink-0 text-subtle transition-colors duration-300 group-hover:text-accent"
                      aria-hidden="true"
                    />
                  )}
                  <span class="min-w-0 flex-1">
                    <p class="text-base font-medium text-fg">{item.name}</p>
                    {item.note && <p class="meta mt-0.5">{item.note}</p>}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <!-- How this site is built -->
    <section class="border-t-2 border-fg pt-12 lg:pt-20">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-4">
          <h2 class="display text-section" data-reveal>This site</h2>
        </div>
        <div class="lg:col-span-7">
          <div class="prose prose-lg" data-reveal style="--reveal-delay:60ms">
            <p>
              Astro with content collections, Tailwind CSS, and no client framework. The JavaScript on a page is a theme
              toggle, a mobile menu, a command palette, a scroll observer and a clock; there is no JS bundle. Fonts are
              self-hosted.
            </p>
            <p>Built to static HTML and deployed by GitHub Actions.</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
