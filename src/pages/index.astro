---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Section from '@/components/Section.astro';
import ProjectFigure from '@/components/ProjectFigure.astro';
import PostCard from '@/components/PostCard.astro';
import Ledger from '@/components/Ledger.astro';
import { site } from '@/lib/site';
import { publishedPosts } from '@/lib/posts';
import { href } from '@/lib/paths';
import { metrics } from '@/data/experience';
import { githubActivity } from '@/lib/feeds';
import { services } from '@/data/stack';
import { Icon } from 'astro-icon/components';
import SocialLinks from '@/components/SocialLinks.astro';

const isPublished = (d: { draft?: boolean }) => import.meta.env.DEV || !d.draft;

const projects = (await getCollection('projects', ({ data }) => isPublished(data)))
  .filter((p) => p.data.featured && !p.data.hidden)
  .sort((a, b) => b.data.weight - a.data.weight);

/** The heaviest desktop capture leads the hero; the rest make the work
 *  section: the next wide one beside the phone, whose height it can meet,
 *  then the remaining wide ones. */
const wide = projects.filter((p) => p.data.device !== 'phone');
const tall = projects.filter((p) => p.data.device === 'phone');
const [lead, ...restWide] = wide;
const pairs = [restWide[0], tall[0]].filter(Boolean);
const rest = [...restWide.slice(1), ...tall.slice(1)];

const posts = (await publishedPosts()).slice(0, 3);

// The repository count is the one figure here that goes stale on its own, so
// it comes from GitHub when reachable and falls back to the curated value.
const github = await githubActivity();
const liveMetrics = github
  ? metrics.map((m) => (m.label === 'Public repositories' ? { ...m, value: String(github.publicRepos) } : m))
  : metrics;

/** Split here, not in the browser, so the markup is the words: copy, search
 *  and a screen reader all get the name. */
const line1 = ['Samuel'];
const line2 = ['Mussie.'];

const marquee = [
  'TypeScript',
  'Python',
  'React',
  'Next.js',
  'FastAPI',
  'PostgreSQL',
  'AWS',
  'Flutter',
  'Docker',
  'RAG',
  'Swift',
  'Terraform',
];

/** The facts, as a ruled ledger under the head of "Types of work". */
const currently: [string, string][] = [
  ['Role', 'Software Engineer'],
  ['Based in', 'Addis Ababa, Ethiopia'],
  ['Focus', 'Full-stack web and mobile: TypeScript, Python, React, PostgreSQL.'],
  ['Timezone', 'EAT / GMT+3'],
];
---

<Layout title={site.title} description={site.description} path="/" type="profile">
  <!-- ── Hero: an ink field, edge to edge (Stage) ───────────────────── -->
  <!-- The name, one sentence and the two actions on five columns; the lead
       product, captured running, on seven. -->
  <section class="field-ink hero-stage relative" style="view-transition-name:field">
    <div class="wrap grid items-center gap-y-12 py-14 lg:grid-cols-[5fr_7fr] lg:gap-x-20 lg:py-16">
      <div class="min-w-0">
        <h1 class="display-xl text-[clamp(4rem,8.4vw,8.5rem)] text-accent">
          <span class="hero-words">
            {
              line1.map((w, i) => (
                <Fragment>
                  <span class="w" style={`--i:${i}`}>
                    {w}
                  </span>{' '}
                </Fragment>
              ))
            }
            <span class="block">
              {
                line2.map((w, i) => (
                  <Fragment>
                    <span class="w" style={`--i:${line1.length + i}`}>
                      {w}
                    </span>
                    {i < line2.length - 1 && ' '}
                  </Fragment>
                ))
              }
            </span>
          </span>
        </h1>

        <p class="hero-enter lead mt-8 text-muted lg:mt-10" style="--enter:300ms">
          Software engineer in Addis Ababa, building web and mobile products since 2016.
        </p>

        <div class="hero-enter mt-10 flex flex-wrap gap-3" style="--enter:380ms">
          <a href={href('/work')} class="btn btn-primary">
            Work
            <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
          </a>
          <a href={href('/about')} class="btn btn-ghost">About</a>
        </div>

        <SocialLinks
          variant="compact"
          class="hero-enter mt-10 flex flex-wrap gap-x-6 gap-y-3"
          rowClass="hit inline-flex items-center gap-2 text-[0.9375rem] text-muted transition-colors hover:text-fg"
          iconClass="size-4"
        />
      </div>

      {
        lead && (
          <ProjectFigure
            project={lead}
            eager
            aspect="aspect-[4/3]"
            sizes="(min-width: 1024px) 52vw, 100vw"
            class="hero-enter min-w-0"
          />
        )
      }
    </div>
  </section>

  <!-- ── Stack ticker: a gold band ─────────────────────────────────── -->
  <div class="marquee-band field-gold relative py-5 lg:py-6">
    <div class="mask-fade-r flex overflow-hidden" aria-hidden="true">
      <ul class="flex shrink-0 animate-marquee items-center gap-10 pr-10 lg:gap-14 lg:pr-14">
        {
          [...marquee, ...marquee].map((m) => (
            <li class="display flex items-center gap-10 whitespace-nowrap text-[clamp(1.5rem,2.6vw,2.25rem)] lg:gap-14">
              {m}
              <span class="text-[0.5em] opacity-60">◆</span>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="sr-only">
      Core stack: {marquee.join(', ')}.
    </p>
    <!-- Hover pauses it for a mouse; this is the same for a thumb or a key
         (WCAG 2.2.2). Nothing moves under reduced motion, so it is not shown. -->
    <button
      type="button"
      class="marquee-toggle hit absolute right-3 top-1/2 z-10 grid size-10 -translate-y-1/2 place-items-center rounded-full border border-line-strong bg-bg text-fg transition-colors hover:bg-surface motion-reduce:hidden lg:right-5"
      aria-pressed="false"
      aria-label="Pause the stack ticker"
      data-marquee-toggle
    >
      <Icon name="lucide:pause" class="marquee-pause size-4" aria-hidden="true" />
      <Icon name="lucide:play" class="marquee-play size-4" aria-hidden="true" />
    </button>
  </div>

  <!-- ── Services, beside the facts ───────────────────────────────── -->
  <Section title="Types of work." id="services" split divider={false} gap="m">
    <Ledger slot="head" rows={currently} align="columns" class="mt-10 text-[0.9375rem] lg:mt-14" />
    <ol class="ledger">
      {
        services.map((s, i) => (
          <li
            class="ledger-row group grid gap-3 py-8 sm:grid-cols-8 sm:items-baseline sm:gap-6 lg:py-10"
            data-reveal
            style={`--reveal-delay:${i * 60}ms`}
          >
            <h3 class="display text-title sm:col-span-4">{s.title}</h3>
            <p class="text-base leading-relaxed text-muted sm:col-span-3">{s.body}</p>
            <Icon
              name={s.icon}
              class="hidden size-6 justify-self-end text-subtle transition-colors group-hover:text-accent sm:col-span-1 sm:block"
              aria-hidden="true"
            />
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- ── Figures ──────────────────────────────────────────────────── -->
  <!-- Four figures as one ruled row, bounded by heavy rules. The label says
       what each counts. -->
  <div class="wrap pb-[var(--section-gap-s)]">
    <dl class="grid grid-cols-2 border-y-2 border-fg lg:grid-cols-4 lg:divide-x lg:divide-line">
      {
        liveMetrics.map((m, i) => (
          <div
            class:list={[
              // Rows shared across the dl, so a label that wraps to two lines
              // lowers every figure beside it, not just its own.
              'row-span-2 grid grid-rows-subgrid py-8 lg:py-12',
              i > 0 && 'lg:pl-8',
              i < 3 && 'lg:pr-8',
              i % 2 === 1 && 'border-l border-line pl-6 lg:border-l-0 lg:pl-8',
              i >= 2 && 'border-t border-line lg:border-t-0',
            ]}
            data-reveal
            style={`--reveal-delay:${i * 60}ms`}
          >
            <dt class="meta">{m.label}</dt>
            <dd class="numeral mt-5 text-[clamp(3rem,6.4vw,6rem)] text-fg" data-count>
              {m.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>

  <!-- ── Selected work ────────────────────────────────────────────── -->
  <Section title="Selected work." id="work" gap="m">
    {/* All lazy: below the fold here, unlike the hero's capture. */}
    <div class="grid gap-x-8 gap-y-16 lg:grid-cols-12 lg:items-center">
      {
        pairs.map((p, i) => (
          <ProjectFigure
            project={p}
            delay={i * 60}
            sizes={p.data.device === 'phone' ? '19rem' : '(min-width: 1024px) 60vw, 100vw'}
            class={p.data.device === 'phone' ? 'lg:col-span-4' : 'lg:col-span-8'}
            captionClass={p.data.device === 'phone' ? 'mx-auto max-w-[19rem]' : ''}
          />
        ))
      }
      <div class="lg:col-span-4 lg:self-end lg:pb-16">
        <a href={href('/work')} class="btn btn-ghost">
          All work
          <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
        </a>
      </div>
      {
        rest.map((p, i) => (
          <ProjectFigure
            project={p}
            delay={i * 60}
            sizes={p.data.device === 'phone' ? '19rem' : '(min-width: 1024px) 60vw, 100vw'}
            class={p.data.device === 'phone' ? 'lg:col-span-4' : 'lg:col-span-8'}
            captionClass={p.data.device === 'phone' ? 'mx-auto max-w-[19rem]' : ''}
          />
        ))
      }
    </div>
  </Section>

  <!-- ── Writing (only when there is something published) ──────────── -->
  {
    posts.length > 0 && (
      <Section title="Writing." id="writing">
        <div>
          {posts.map((post, i) => (
            <PostCard post={post} index={i} />
          ))}
        </div>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href={href('/writing')} class="btn btn-ghost">
            All writing
            <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
          </a>
          <a href={href('/rss.xml')} class="btn btn-ghost">
            <Icon name="lucide:rss" class="size-4" aria-hidden="true" />
            RSS
          </a>
        </div>
      </Section>
    )
  }
</Layout>

<script>
  import { countUp } from '@/lib/client/count';
  countUp();

  /* The ticker's pause: a state on the band, so the CSS decides what stops. */
  const toggle = document.querySelector<HTMLButtonElement>('[data-marquee-toggle]');
  toggle?.addEventListener('click', () => {
    const paused = toggle.getAttribute('aria-pressed') !== 'true';
    toggle.setAttribute('aria-pressed', String(paused));
    toggle.closest('.marquee-band')?.toggleAttribute('data-paused', paused);
  });
</script>
