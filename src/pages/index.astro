---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Section from '@/components/Section.astro';
import PreviewFrame from '@/components/PreviewFrame.astro';
import PostCard from '@/components/PostCard.astro';
import { site, socials } from '@/lib/site';
import { publishedPosts } from '@/lib/posts';
import { href } from '@/lib/paths';
import { metrics } from '@/data/experience';
import { githubActivity } from '@/lib/feeds';
import { services } from '@/data/stack';
import { Icon } from 'astro-icon/components';

const isPublished = (d: { draft?: boolean }) => import.meta.env.DEV || !d.draft;

const projects = (await getCollection('projects', ({ data }) => isPublished(data)))
  .filter((p) => p.data.featured && !p.data.hidden)
  .sort((a, b) => b.data.weight - a.data.weight);

/**
 * The spread: desktop frames stack in the wide column, phones stand in the
 * narrow one. Two shapes of screenshot laid out by shape rather than forced
 * into equal cells, which would leave a 16:10 frame beside a portrait one
 * with half a column of nothing under it.
 */
const wide = projects.filter((p) => p.data.device !== 'phone');
const tall = projects.filter((p) => p.data.device === 'phone');

const posts = (await publishedPosts()).slice(0, 3);

// The repository count is the one figure here that goes stale on its own, so
// it comes from GitHub when reachable and falls back to the curated value.
const github = await githubActivity();
const liveMetrics = github
  ? metrics.map((m) =>
      m.label === 'Public repositories' ? { ...m, value: String(github.publicRepos) } : m,
    )
  : metrics;

/**
 * The tagline, word by word, so each can enter on its own beat. Split here
 * rather than in the browser so the markup is the words — copy, search and a
 * screen reader all get "No software engineering problem is too big to
 * solve." — and nothing depends on a script having run.
 */
const line1 = ['No', 'software', 'engineering', 'problem'];
const line2 = ['is', 'too', 'big', 'to', 'solve.'];

const marquee = [
  'TypeScript',
  'Python',
  'React',
  'Next.js',
  'FastAPI',
  'PostgreSQL',
  'AWS',
  'Flutter',
  'Docker',
  'RAG',
  'Swift',
  'Terraform',
];

const statusTone: Record<string, string> = {
  Live: 'text-jade',
  Ongoing: 'text-jade',
  Shipped: 'text-muted',
  Experiment: 'text-accent',
  Archived: 'text-subtle',
};
---

<Layout title={site.title} description={site.description} path="/" type="profile">
  <!-- ── Hero: an ink field, edge to edge ─────────────────────────── -->
  <!-- Full-width rather than in .wrap on purpose: the headline is sized to
       the viewport, and a poster runs to the edge of the sheet. Everything
       below returns to the centred column. -->
  <section class="field-ink relative overflow-hidden" style="view-transition-name:field">
    <div class="pointer-events-none absolute inset-0 grid-lines-12 opacity-60" aria-hidden="true">
    </div>

    <div class="relative px-5 pb-14 pt-10 sm:px-8 lg:pb-24 lg:pt-20 xl:px-12 2xl:px-16">
      <p class="eyebrow hero-enter" style="--enter:0ms">
        <a href={href('/contact')} class="hit transition-colors hover:text-accent">Reach out</a>
        <span class="hidden text-line-strong sm:inline" aria-hidden="true">/</span>
        <span class="hidden sm:inline">{site.location}</span>
      </p>

      <h1 class="display-hero hero-words mt-10 text-[clamp(3rem,10.2vw,10rem)] lg:mt-14">
        {
          line1.map((w, i) => (
            <Fragment>
              <span class:list={['w', i === 0 && 'text-accent']} style={`--i:${i}`}>
                {w}
              </span>{' '}
            </Fragment>
          ))
        }
        <em class="block italic text-accent">
          {
            line2.map((w, i) => (
              <Fragment>
                <span class="w" style={`--i:${line1.length + i}`}>
                  {w}
                </span>
                {i < line2.length - 1 && ' '}
              </Fragment>
            ))
          }
        </em>
      </h1>

      <div class="mt-14 grid gap-10 lg:mt-24 lg:grid-cols-12 lg:gap-8">
        <!-- Intro -->
        <div class="lg:col-span-7">
          <p
            class="hero-enter max-w-2xl text-[1.125rem] leading-[1.6] text-muted lg:text-[1.5rem] lg:leading-[1.45]"
            style="--enter:470ms"
          >
            <strong class="font-medium text-fg">Samuel Mussie</strong> — software engineer based in Addis
            Ababa, Ethiopia. Ten years building web and mobile products: Python and TypeScript services,
            React and Next.js front ends, Flutter and native iOS, and retrieval-augmented AI features.
          </p>

          <div
            class="hero-enter mt-10 flex flex-wrap items-center gap-x-8 gap-y-5"
            style="--enter:570ms"
          >
            <div class="flex flex-wrap gap-3">
              <a href={href('/work')} class="btn btn-primary">
                Work
                <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
              </a>
              <a href={href('/about')} class="btn btn-ghost">About</a>
            </div>

            <ul class="flex flex-wrap gap-x-6 gap-y-3">
              {
                socials.map((s) => (
                  <li>
                    <a
                      href={s.href}
                      target={s.href.startsWith('http') ? '_blank' : undefined}
                      rel={s.href.startsWith('http') ? 'noopener noreferrer me' : undefined}
                      class="hit group inline-flex items-center gap-2 font-mono text-2xs uppercase tracking-[0.1em] text-subtle transition-colors hover:text-fg"
                    >
                      <Icon name={s.icon} class="size-3.5" aria-hidden="true" />
                      {s.handle}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <!-- Currently: the same facts, as a ruled table. -->
        <aside class="hero-enter lg:col-span-4 lg:col-start-9" style="--enter:670ms">
          <h2 class="meta">Currently</h2>
          <dl class="ledger mt-4 text-sm">
            <div class="grid grid-cols-[6.5rem_1fr] gap-4 py-3.5">
              <dt class="text-subtle">Role</dt>
              <dd class="leading-snug text-fg">Software Engineer</dd>
            </div>
            <div class="grid grid-cols-[6.5rem_1fr] gap-4 py-3.5">
              <dt class="text-subtle">Based in</dt>
              <dd class="leading-snug text-fg">Addis Ababa, Ethiopia</dd>
            </div>
            <div class="grid grid-cols-[6.5rem_1fr] gap-4 py-3.5">
              <dt class="text-subtle">Focus</dt>
              <dd class="leading-snug text-fg">
                Full-stack web and mobile — TypeScript, Python, React, PostgreSQL.
              </dd>
            </div>
            <div class="grid grid-cols-[6.5rem_1fr] gap-4 py-3.5">
              <dt class="text-subtle">Timezone</dt>
              <dd class="leading-snug text-fg">EAT / GMT+3</dd>
            </div>
          </dl>
          <a
            href={href('/contact')}
            class="hit group mt-5 inline-flex items-center gap-2 text-sm text-fg transition-colors hover:text-accent"
          >
            <span class="link">Start a conversation</span>
            <Icon
              name="lucide:arrow-right"
              class="size-4 transition-transform duration-300 group-hover:translate-x-1"
              aria-hidden="true"
            />
          </a>
        </aside>
      </div>
    </div>
  </section>

  <!-- ── Stack ticker: a gold band ─────────────────────────────────── -->
  <div class="marquee-band field-gold relative py-5 lg:py-6">
    <div class="mask-fade-r flex overflow-hidden" aria-hidden="true">
      <ul class="flex shrink-0 animate-marquee items-center gap-10 pr-10 lg:gap-14 lg:pr-14">
        {
          [...marquee, ...marquee].map((m) => (
            <li class="display flex items-center gap-10 whitespace-nowrap text-[clamp(1.5rem,2.6vw,2.25rem)] italic lg:gap-14">
              {m}
              <span class="text-[0.5em] not-italic opacity-60">◆</span>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="sr-only">
      Core stack: {marquee.join(', ')}.
    </p>
  </div>

  <!-- ── Metrics ──────────────────────────────────────────────────── -->
  <!-- Four figures as one ruled row, bounded by heavy rules. Big enough to be
       read from across the room. -->
  <div class="wrap py-6 lg:py-10">
    <dl class="grid grid-cols-2 border-y-2 border-fg lg:grid-cols-4 lg:divide-x lg:divide-line">
      {
        liveMetrics.map((m, i) => (
          <div
            class:list={[
              'py-8 lg:py-12',
              i > 0 && 'lg:pl-8',
              i < 3 && 'lg:pr-8',
              i % 2 === 1 && 'border-l border-line pl-6 lg:border-l-0 lg:pl-8',
              i >= 2 && 'border-t border-line lg:border-t-0',
            ]}
            data-reveal
            style={`--reveal-delay:${i * 70}ms`}
          >
            <dt class="meta">{m.label}</dt>
            <dd class="numeral mt-5 text-[clamp(3rem,7.4vw,6rem)] text-fg" data-count>
              {m.value}
            </dd>
            {m.note && <p class="mt-3 text-[0.8125rem] leading-snug text-subtle">{m.note}</p>}
          </div>
        ))
      }
    </dl>
  </div>

  <!-- ── Services ─────────────────────────────────────────────────── -->
  <Section
    index="01"
    eyebrow="Work"
    title="Types of work."
    lede="Full-stack, across web and mobile."
    id="services"
  >
    <ol class="ledger">
      {
        services.map((s, i) => (
          <li
            class="ledger-row group grid gap-3 py-8 sm:grid-cols-12 sm:items-baseline sm:gap-6 lg:py-11"
            data-reveal
            style={`--reveal-delay:${i * 70}ms`}
          >
            <span class="row-index numeral text-[1.5rem] text-subtle sm:col-span-1">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="row-title display text-[clamp(1.75rem,3.8vw,2.9rem)] sm:col-span-6 lg:col-span-5">
              {s.title}
            </h3>
            <p class="text-[0.9375rem] leading-relaxed text-muted sm:col-span-4 lg:col-span-5 lg:text-base">
              {s.body}
            </p>
            <Icon
              name={s.icon}
              class="hidden size-5 justify-self-end text-subtle transition-colors duration-300 group-hover:text-accent sm:col-span-1 sm:block"
              aria-hidden="true"
            />
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- ── Selected work ────────────────────────────────────────────── -->
  <Section
    index="02"
    eyebrow="Selected work"
    title="Projects."
    lede="Client work ships under other names. These are the public ones."
    id="work"
  >
    <div class="grid gap-10 lg:grid-cols-12 lg:items-start lg:gap-8">
      <div class="grid gap-10 lg:col-span-7 lg:gap-14">
        {
          wide.map((p, i) => (
            <figure data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <PreviewFrame project={p} eager={i === 0} />
              <figcaption class="mt-4 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                <h3 class="display text-[1.5rem]" style={`view-transition-name:project-${p.id}`}>
                  <a href={href(`/work/${p.id}`)} class="group/link">
                    <span class="link">{p.data.title}</span>
                    <Icon
                      name="lucide:arrow-right"
                      class="ml-0.5 inline-block size-[0.7em] -translate-y-px text-subtle transition-transform duration-300 group-hover/link:translate-x-1 group-hover/link:text-accent"
                      aria-hidden="true"
                    />
                  </a>
                </h3>
                <p class="meta flex items-center gap-2">
                  {p.data.kind}
                  <span class="text-line-strong" aria-hidden="true">
                    ·
                  </span>
                  <span class={statusTone[p.data.status] ?? 'text-muted'}>{p.data.status}</span>
                </p>
              </figcaption>
            </figure>
          ))
        }
      </div>

      {
        tall.length > 0 && (
          <div class="grid gap-10 lg:col-span-4 lg:col-start-9 lg:gap-14">
            {tall.map((p, i) => (
              <figure data-reveal style={`--reveal-delay:${(wide.length + i) * 80}ms`}>
                <PreviewFrame project={p} />
                <figcaption class="mx-auto mt-4 flex max-w-[19rem] flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                  <h3 class="display text-[1.5rem]" style={`view-transition-name:project-${p.id}`}>
                    <a href={href(`/work/${p.id}`)} class="group/link">
                      <span class="link">{p.data.title}</span>
                      <Icon
                        name="lucide:arrow-right"
                        class="ml-0.5 inline-block size-[0.7em] -translate-y-px text-subtle transition-transform duration-300 group-hover/link:translate-x-1 group-hover/link:text-accent"
                        aria-hidden="true"
                      />
                    </a>
                  </h3>
                  <p class="meta flex items-center gap-2">
                    {p.data.kind}
                    <span class="text-line-strong" aria-hidden="true">
                      ·
                    </span>
                    <span class={statusTone[p.data.status] ?? 'text-muted'}>{p.data.status}</span>
                  </p>
                </figcaption>
              </figure>
            ))}
          </div>
        )
      }
    </div>

    <div class="mt-12 lg:mt-16">
      <a href={href('/work')} class="btn btn-ghost">
        Details
        <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
      </a>
    </div>
  </Section>

  <!-- ── Writing (only when there is something published) ──────────── -->
  {
    posts.length > 0 && (
      <Section index="03" eyebrow="Writing" title="Writing." lede="Posts." id="writing">
        <div>
          {posts.map((post, i) => (
            <PostCard post={post} index={i} />
          ))}
        </div>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href={href('/writing')} class="btn btn-ghost">
            All writing
            <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
          </a>
          <a href={href('/rss.xml')} class="btn btn-ghost">
            <Icon name="lucide:rss" class="size-4" aria-hidden="true" />
            RSS
          </a>
        </div>
      </Section>
    )
  }
</Layout>

<script is:inline>
  // Figures count up from zero when they scroll into view. The markup holds
  // the final value, so with no script, reduced motion, or an old browser the
  // number is simply there. The suffix — " yrs", "+" — rides along untouched.
  (() => {
    if (
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      !('IntersectionObserver' in window)
    ) {
      return;
    }
    const ease = (t) => 1 - Math.pow(1 - t, 5);
    const DURATION = 1400;

    function run(el) {
      const match = el.textContent.trim().match(/^(\d+)(.*)$/);
      if (!match) return;
      const target = Number(match[1]);
      const suffix = match[2];
      const start = performance.now();
      const tick = (now) => {
        const p = Math.min(1, (now - start) / DURATION);
        el.textContent = Math.round(target * ease(p)) + suffix;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          run(entry.target);
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.4 },
    );
    document.querySelectorAll('[data-count]').forEach((el) => io.observe(el));
  })();
</script>
