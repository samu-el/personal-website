---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Section from '@/components/Section.astro';
import ProjectFigure from '@/components/ProjectFigure.astro';
import PostCard from '@/components/PostCard.astro';
import Ledger from '@/components/Ledger.astro';
import { site } from '@/lib/site';
import { publishedPosts } from '@/lib/posts';
import { href } from '@/lib/paths';
import { metrics } from '@/data/experience';
import { githubActivity } from '@/lib/feeds';
import { services } from '@/data/stack';
import { Icon } from 'astro-icon/components';
import SocialLinks from '@/components/SocialLinks.astro';

const isPublished = (d: { draft?: boolean }) => import.meta.env.DEV || !d.draft;

const projects = (await getCollection('projects', ({ data }) => isPublished(data)))
  .filter((p) => p.data.featured && !p.data.hidden)
  .sort((a, b) => b.data.weight - a.data.weight);

/** Laid out by shape: a 16:10 frame beside a portrait one leaves half a
 *  column of nothing under it. */
const wide = projects.filter((p) => p.data.device !== 'phone');
const tall = projects.filter((p) => p.data.device === 'phone');

const posts = (await publishedPosts()).slice(0, 3);

// The repository count is the one figure here that goes stale on its own, so
// it comes from GitHub when reachable and falls back to the curated value.
const github = await githubActivity();
const liveMetrics = github
  ? metrics.map((m) => (m.label === 'Public repositories' ? { ...m, value: String(github.publicRepos) } : m))
  : metrics;

/** Split here, not in the browser, so the markup is the words: copy, search
 *  and a screen reader all get the sentence. */
const line1 = ['No', 'software', 'engineering', 'problem'];
const line2 = ['is', 'too', 'big', 'to', 'solve.'];

const marquee = [
  'TypeScript',
  'Python',
  'React',
  'Next.js',
  'FastAPI',
  'PostgreSQL',
  'AWS',
  'Flutter',
  'Docker',
  'RAG',
  'Swift',
  'Terraform',
];

/** The Currently table: the same facts as the intro, as a ruled ledger. */
const currently: [string, string][] = [
  ['Role', 'Software Engineer'],
  ['Based in', 'Addis Ababa, Ethiopia'],
  ['Focus', 'Full-stack web and mobile — TypeScript, Python, React, PostgreSQL.'],
  ['Timezone', 'EAT / GMT+3'],
];
---

<Layout title={site.title} description={site.description} path="/" type="profile">
  <!-- ── Hero: an ink field, edge to edge ─────────────────────────── -->
  <!-- The field runs edge to edge; its content keeps to .wrap, so the eyebrow,
       lede and buttons share an edge with the logo and every section below. -->
  <section class="field-ink relative overflow-hidden" style="view-transition-name:field">
    <div class="pointer-events-none absolute inset-0 grid-lines-12 opacity-60" aria-hidden="true"></div>

    <div class="wrap relative pb-14 pt-10 lg:pb-24 lg:pt-20">
      <p class="eyebrow hero-enter" style="--enter:0ms">
        <a href={href('/contact')} class="hit transition-colors hover:text-accent">Reach out</a>
        <span class="hidden text-line-strong sm:inline" aria-hidden="true">/</span>
        <span class="hidden sm:inline">{site.location}</span>
      </p>

      <h1 class="display-hero hero-words mt-10 text-[clamp(3rem,10.2vw,10rem)] lg:mt-14">
        {
          line1.map((w, i) => (
            <Fragment>
              <span class:list={['w', i === 0 && 'text-accent']} style={`--i:${i}`}>
                {w}
              </span>{' '}
            </Fragment>
          ))
        }
        <em class="block italic text-accent">
          {
            line2.map((w, i) => (
              <Fragment>
                <span class="w" style={`--i:${line1.length + i}`}>
                  {w}
                </span>
                {i < line2.length - 1 && ' '}
              </Fragment>
            ))
          }
        </em>
      </h1>

      <div class="mt-14 grid gap-10 lg:mt-24 lg:grid-cols-12 lg:gap-8">
        <!-- Intro -->
        <div class="lg:col-span-7">
          <p
            class="hero-enter max-w-2xl text-[1.125rem] leading-[1.6] text-muted lg:text-[1.5rem] lg:leading-[1.45]"
            style="--enter:470ms"
          >
            <strong class="font-medium text-fg">Samuel Mussie</strong> — software engineer based in Addis Ababa, Ethiopia.
            Ten years building web and mobile products: Python and TypeScript services, React and Next.js front ends, Flutter
            and native iOS, and retrieval-augmented AI features.
          </p>

          <div class="hero-enter mt-10 flex flex-wrap items-center gap-x-8 gap-y-5" style="--enter:570ms">
            <div class="flex flex-wrap gap-3">
              <a href={href('/work')} class="btn btn-primary">
                Work
                <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
              </a>
              <a href={href('/about')} class="btn btn-ghost">About</a>
            </div>

            <SocialLinks
              variant="compact"
              class="flex flex-wrap gap-x-6 gap-y-3"
              rowClass="hit inline-flex items-center gap-2 meta transition-colors hover:text-fg"
            />
          </div>
        </div>

        <!-- Currently: the same facts, as a ruled table. -->
        <!-- A div, not an aside: a complementary landmark inside main is not top-level. -->
        <div class="hero-enter lg:col-span-4 lg:col-start-9" style="--enter:670ms">
          <h2 class="meta">Currently</h2>
          <Ledger rows={currently} align="columns" />
          <a
            href={href('/contact')}
            class="hit group mt-5 inline-flex items-center gap-2 text-sm text-fg transition-colors hover:text-accent"
          >
            <span class="link">Start a conversation</span>
            <Icon
              name="lucide:arrow-right"
              class="size-4 transition-transform duration-300 group-hover:translate-x-1"
              aria-hidden="true"
            />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Stack ticker: a gold band ─────────────────────────────────── -->
  <div class="marquee-band field-gold relative py-5 lg:py-6">
    <div class="mask-fade-r flex overflow-hidden" aria-hidden="true">
      <ul class="flex shrink-0 animate-marquee items-center gap-10 pr-10 lg:gap-14 lg:pr-14">
        {
          [...marquee, ...marquee].map((m) => (
            <li class="display flex items-center gap-10 whitespace-nowrap text-[clamp(1.5rem,2.6vw,2.25rem)] italic lg:gap-14">
              {m}
              <span class="text-[0.5em] not-italic opacity-60">◆</span>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="sr-only">
      Core stack: {marquee.join(', ')}.
    </p>
    <!-- Hover pauses it for a mouse; this is the same for a thumb or a key
         (WCAG 2.2.2). Nothing moves under reduced motion, so it is not shown. -->
    <button
      type="button"
      class="marquee-toggle hit absolute right-3 top-1/2 z-10 grid size-8 -translate-y-1/2 place-items-center rounded-full border border-line-strong bg-bg text-fg transition-colors hover:bg-surface motion-reduce:hidden lg:right-5"
      aria-pressed="false"
      aria-label="Pause the stack ticker"
      data-marquee-toggle
    >
      <Icon name="lucide:pause" class="marquee-pause size-3.5" aria-hidden="true" />
      <Icon name="lucide:play" class="marquee-play size-3.5" aria-hidden="true" />
    </button>
  </div>

  <!-- ── Metrics ──────────────────────────────────────────────────── -->
  <!-- Four figures as one ruled row, bounded by heavy rules. Big enough to be
       read from across the room. -->
  <div class="wrap py-6 lg:py-10">
    <dl class="grid grid-cols-2 border-y-2 border-fg lg:grid-cols-4 lg:divide-x lg:divide-line">
      {
        liveMetrics.map((m, i) => (
          <div
            class:list={[
              // Rows shared across the dl, so a label that wraps to two lines
              // lowers every figure beside it, not just its own.
              'row-span-3 grid grid-rows-subgrid py-8 lg:py-12',
              i > 0 && 'lg:pl-8',
              i < 3 && 'lg:pr-8',
              i % 2 === 1 && 'border-l border-line pl-6 lg:border-l-0 lg:pl-8',
              i >= 2 && 'border-t border-line lg:border-t-0',
            ]}
            data-reveal
            style={`--reveal-delay:${i * 70}ms`}
          >
            <dt class="meta">{m.label}</dt>
            <dd class="numeral mt-5 text-[clamp(3rem,7.4vw,6rem)] text-fg" data-count>
              {m.value}
            </dd>
            {/* A second dd, not a p: a dl group holds only dt and dd. */}
            {m.note && <dd class="mt-3 text-[0.8125rem] leading-snug text-subtle">{m.note}</dd>}
          </div>
        ))
      }
    </dl>
  </div>

  <!-- ── Services ─────────────────────────────────────────────────── -->
  <Section index="01" eyebrow="Work" title="Types of work." lede="Full-stack, across web and mobile." id="services">
    <ol class="ledger">
      {
        services.map((s, i) => (
          <li
            class="ledger-row group grid gap-3 py-8 sm:grid-cols-12 sm:items-baseline sm:gap-6 lg:py-11"
            data-reveal
            style={`--reveal-delay:${i * 70}ms`}
          >
            <span class="row-index numeral text-[1.5rem] text-subtle sm:col-span-1">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="row-title display text-[clamp(1.75rem,3.8vw,2.9rem)] sm:col-span-6 lg:col-span-5">{s.title}</h3>
            <p class="text-[0.9375rem] leading-relaxed text-muted sm:col-span-4 lg:col-span-5 lg:text-base">{s.body}</p>
            <Icon
              name={s.icon}
              class="hidden size-5 justify-self-end text-subtle transition-colors duration-300 group-hover:text-accent sm:col-span-1 sm:block"
              aria-hidden="true"
            />
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- ── Selected work ────────────────────────────────────────────── -->
  <Section
    index="02"
    eyebrow="Selected work"
    title="Projects."
    lede="Client work ships under other names. These are the public ones."
    id="work"
  >
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
      <div class="grid gap-10 lg:col-span-7 lg:gap-14 lg:self-start">
        {/* All lazy: below the fold here, unlike on /work where the first is the LCP. */}
        {wide.map((p, i) => <ProjectFigure project={p} delay={i * 80} />)}
      </div>

      <!-- The way on to /work closes the right column, level with the foot of
           the left one, rather than hanging alone under the whole grid. -->
      <div class="flex flex-col gap-10 lg:col-span-4 lg:col-start-9 lg:gap-14">
        {
          tall.map((p, i) => (
            <ProjectFigure project={p} delay={(wide.length + i) * 80} captionClass="mx-auto max-w-[19rem]" />
          ))
        }
        <div class:list={['lg:mt-auto', tall.length > 0 && 'lg:mx-auto lg:w-full lg:max-w-[19rem]']}>
          <a href={href('/work')} class="btn btn-ghost">
            Details
            <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </Section>

  <!-- ── Writing (only when there is something published) ──────────── -->
  {
    posts.length > 0 && (
      <Section index="03" eyebrow="Writing" title="Writing." lede="Posts." id="writing">
        <div>
          {posts.map((post, i) => (
            <PostCard post={post} index={i} />
          ))}
        </div>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href={href('/writing')} class="btn btn-ghost">
            All writing
            <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
          </a>
          <a href={href('/rss.xml')} class="btn btn-ghost">
            <Icon name="lucide:rss" class="size-4" aria-hidden="true" />
            RSS
          </a>
        </div>
      </Section>
    )
  }
</Layout>

<script>
  import { countUp } from '@/lib/client/count';
  countUp();

  /* The ticker's pause: a state on the band, so the CSS decides what stops. */
  const toggle = document.querySelector<HTMLButtonElement>('[data-marquee-toggle]');
  toggle?.addEventListener('click', () => {
    const paused = toggle.getAttribute('aria-pressed') !== 'true';
    toggle.setAttribute('aria-pressed', String(paused));
    toggle.closest('.marquee-band')?.toggleAttribute('data-paused', paused);
  });
</script>
