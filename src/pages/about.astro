---
import Chips from '@/components/Chips.astro';
import Ledger from '@/components/Ledger.astro';
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import { site } from '@/lib/site';
import { href } from '@/lib/paths';
import { roles } from '@/data/experience';
import SocialLinks from '@/components/SocialLinks.astro';

const title = 'About';
const description =
  'Samuel Mussie, software engineer in Addis Ababa. Ten years building web and mobile products end to end, across eight languages and three platforms.';

const glance: [string, string][] = [
  ['Role', site.role],
  ['Focus', 'Full-stack, web & mobile'],
  ['Based in', 'Addis Ababa, ET'],
  ['Studied at', 'Addis Ababa University'],
  ['Since', '2016'],
  ['Languages', 'Amharic, English'],
  ['Timezone', 'EAT / GMT+3'],
];
---

<Layout {title} {description} path="/about" type="profile">
  <PageHeader>
    Software engineer,<br />
    Addis Ababa.
  </PageHeader>

  <!-- ── Narrative ────────────────────────────────────────────────── -->
  <div class="wrap sec-follow">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <div class="prose prose-lg" data-reveal>
          <p>
            Samuel Mussie is a software engineer based in Addis Ababa, Ethiopia. He works across the stack on web and
            mobile products, from data modelling and services through to front ends and deployment.
          </p>
          <p>
            He is currently at <a href={site.companyUrl} target="_blank" rel="noopener noreferrer">Mereb Technologies</a
            >, where the work covers multi-tenant SaaS platforms, procurement and telemedicine systems, mobile
            applications, and retrieval-augmented AI features for clients in Europe and the US. Before that, four years
            of independent contract development on client stacks: Node and Python services, React front ends, iOS and
            Flutter applications, and Telegram bots.
          </p>

          <h2>Languages and platforms</h2>
          <p>
            Production experience in TypeScript, Python, JavaScript, Dart, Swift, PHP, Java and SQL. Web, iOS and
            Android. A full list of tools is on the <a href={href('/stack')}>stack</a> page.
          </p>

          <h2>Education</h2>
          <p>Undergraduate studies at Addis Ababa University.</p>

          <h2>Code</h2>
          <p>
            Around thirty public repositories going back to 2016, at <a
              href="https://github.com/samu-el"
              target="_blank"
              rel="noopener noreferrer">github.com/samu-el</a
            >. Selected work is on the <a href={href('/work')}>work</a> page.
          </p>
        </div>
      </div>

      <!-- The facts as a ruled table, sticky beside the prose; its terms are its
           labels. A div: an aside inside main is not a top-level landmark. -->
      <div class="lg:col-span-4 lg:col-start-9">
        <div class="lg:sticky lg:top-24" data-reveal style="--reveal-delay:80ms">
          <Ledger rows={glance} class="text-[0.9375rem]" />
          <SocialLinks
            class="mt-6 space-y-3"
            rowClass="hit flex items-center justify-between gap-3 text-[0.9375rem] text-muted transition-colors hover:text-fg"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- ── Timeline ─────────────────────────────────────────────────── -->
  <!-- A rail rather than a stack of boxes: the years run down the left, the
       roles hang off it, and the hairline between them is the timeline. -->
  <Section title="Timeline." id="timeline" gap="m">
    <ol class="ledger">
      {
        roles.map((role, i) => (
          <li
            class="ledger-row relative grid gap-6 py-10 lg:grid-cols-12 lg:gap-8 lg:py-14"
            data-reveal
            style={`--reveal-delay:${i * 80}ms`}
          >
            {/* Period column, its years on the role title's baseline */}
            <div class="lg:col-span-4">
              {/* One line, in words: "2016 to 2020", "2020 to present". */}
              <p class="numeral text-[clamp(1.75rem,2.8vw,2.5rem)] text-fg">
                {role.from ? `${role.from} to ${role.current ? role.to.toLowerCase() : role.to}` : 'Earlier'}
              </p>
              <p class="meta mt-4">{role.location}</p>
            </div>
            {/* Role */}
            <div class="lg:col-span-7 lg:col-start-6">
              <h3 class="display text-title">{role.title}</h3>
              <p class="mt-2 text-base text-accent">
                {role.url ? (
                  <a href={role.url} target="_blank" rel="noopener noreferrer" class="link link-accent">
                    {role.org}
                  </a>
                ) : (
                  role.org
                )}
              </p>
              {role.summary && <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted">{role.summary}</p>}
              {role.highlights.length > 0 && (
                <ul class="mt-6 space-y-2.5">
                  {role.highlights.map((h) => (
                    <li class="relative max-w-2xl pl-5 text-base leading-6 text-muted">
                      {/* Whole pixels: a hairline at 0.72em landed between rows and
                          each dash antialiased to a different shade. */}
                      <span class="absolute left-0 top-3 h-px w-2.5 bg-accent" aria-hidden="true" />
                      {h}
                    </li>
                  ))}
                </ul>
              )}
              <Chips items={role.tags} label="Focus areas" />
            </div>
          </li>
        ))
      }
    </ol>
  </Section>
</Layout>
