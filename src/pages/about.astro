---
import Chips from '@/components/Chips.astro';
import Ledger from '@/components/Ledger.astro';
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import { navIndex } from '@/lib/posts';
import { site } from '@/lib/site';
import { href } from '@/lib/paths';
import { roles } from '@/data/experience';
import SocialLinks from '@/components/SocialLinks.astro';

const title = 'About';
const description =
  'Samuel Mussie — software engineer in Addis Ababa. Ten years building web and mobile products end to end, across eight languages and three platforms.';

const index = await navIndex('/about');

const glance: [string, string][] = [
  ['Role', site.role],
  ['Focus', 'Full-stack, web & mobile'],
  ['Based in', 'Addis Ababa, ET'],
  ['Studied at', 'Addis Ababa University'],
  ['Since', '2016'],
  ['Languages', 'Amharic, English'],
  ['Timezone', 'EAT / GMT+3'],
];
---

<Layout {title} {description} path="/about" type="profile">
  <PageHeader {index} label="About">
    Software engineer,
    <em class="block italic text-accent">Addis Ababa.</em>
    <Fragment slot="aside">
      Ten years of web and mobile development across eight languages and three platforms. Currently at Mereb
      Technologies, building products for clients in Europe and the US.
    </Fragment>
  </PageHeader>

  <!-- ── Narrative ────────────────────────────────────────────────── -->
  <div class="wrap py-12 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <div class="prose prose-lg" data-reveal>
          <p>
            Samuel Mussie is a software engineer based in Addis Ababa, Ethiopia. He works across the stack on web and
            mobile products — data modelling and services through to front ends and deployment.
          </p>
          <p>
            He is currently at <a href={site.companyUrl} target="_blank" rel="noopener noreferrer">Mereb Technologies</a
            >, where the work covers multi-tenant SaaS platforms, procurement and telemedicine systems, mobile
            applications, and retrieval-augmented AI features for clients in Europe and the US. Before that, four years
            of independent contract development on client stacks: Node and Python services, React front ends, iOS and
            Flutter applications, and Telegram bots.
          </p>

          <h2>Languages and platforms</h2>
          <p>
            Production experience in TypeScript, Python, JavaScript, Dart, Swift, PHP, Java and SQL. Web, iOS and
            Android. A full list of tools is on the <a href={href('/stack')}>stack</a> page.
          </p>

          <h2>Education</h2>
          <p>Undergraduate studies at Addis Ababa University.</p>

          <h2>Code</h2>
          <p>
            Around thirty public repositories going back to 2016, at <a
              href="https://github.com/samu-el"
              target="_blank"
              rel="noopener noreferrer">github.com/samu-el</a
            >. Selected work is on the <a href={href('/work')}>work</a> page.
          </p>
        </div>
      </div>

      <!-- At a glance: a ruled table, sticky beside the prose. -->
      <aside class="lg:col-span-4 lg:col-start-9">
        <div class="lg:sticky lg:top-24" data-reveal style="--reveal-delay:80ms">
          <h2 class="meta">At a glance</h2>
          <Ledger rows={glance} />
          <SocialLinks
            class="mt-6 space-y-3"
            rowClass="flex items-center justify-between gap-3 text-sm text-muted transition-colors hover:text-fg"
          />
        </div>
      </aside>
    </div>
  </div>

  <!-- ── Timeline ─────────────────────────────────────────────────── -->
  <!-- A rail rather than a stack of boxes: the years run down the left, the
       roles hang off it, and the hairline between them is the timeline. -->
  <Section index="05" eyebrow="Timeline" title="Timeline." id="timeline">
    <ol class="ledger">
      {
        roles.map((role, i) => (
          <li
            class="ledger-row relative grid gap-5 py-9 lg:grid-cols-12 lg:gap-8 lg:py-12"
            data-reveal
            style={`--reveal-delay:${i * 80}ms`}
          >
            {/* Period column */}
            <div class="lg:col-span-4">
              <p class="row-index numeral flex items-baseline gap-3 text-[clamp(1.75rem,3.4vw,2.5rem)] text-fg">
                {role.from ? (
                  <>
                    {role.from}
                    <span class="text-subtle" aria-hidden="true">
                      —
                    </span>
                    <span class={role.current ? 'text-accent' : ''}>{role.to}</span>
                  </>
                ) : (
                  <span class="text-subtle">Earlier</span>
                )}
                {role.current && (
                  <span class="relative ml-1 flex size-2 self-center">
                    <span class="absolute inline-flex size-full animate-ping rounded-full bg-jade opacity-70" />
                    <span class="relative inline-flex size-2 rounded-full bg-jade" />
                  </span>
                )}
              </p>
              <p class="meta mt-3 normal-case tracking-normal">{role.location}</p>
            </div>

            {/* Role */}
            <div class="lg:col-span-7 lg:col-start-6">
              <h3 class="row-title display text-[clamp(1.5rem,2.6vw,1.9rem)]">{role.title}</h3>
              <p class="mt-1.5 text-[0.9375rem] text-accent">
                {role.url ? (
                  <a href={role.url} target="_blank" rel="noopener noreferrer" class="link link-accent">
                    {role.org}
                  </a>
                ) : (
                  role.org
                )}
              </p>
              {role.summary && (
                <p class="mt-5 max-w-2xl text-[0.9375rem] leading-relaxed text-muted lg:text-base">{role.summary}</p>
              )}
              {role.highlights.length > 0 && (
                <ul class="mt-6 space-y-2.5">
                  {role.highlights.map((h) => (
                    <li class="relative max-w-2xl pl-5 text-[0.9375rem] leading-relaxed text-muted">
                      <span class="absolute left-0 top-[0.72em] h-px w-2.5 bg-accent" aria-hidden="true" />
                      {h}
                    </li>
                  ))}
                </ul>
              )}
              <Chips items={role.tags} label="Focus areas" />
            </div>
          </li>
        ))
      }
    </ol>
  </Section>
</Layout>
