---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CommandPalette from '@/components/CommandPalette.astro';
import EasterEggs from '@/components/EasterEggs.astro';
import { nav, site } from '@/lib/site';

interface Props {
  title: string;
  description?: string;
  path?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  /** Drops the footer CTA — used on the contact page, where it would repeat. */
  bareFooter?: boolean;
}

const { bareFooter = false, ...head } = Astro.props;

/** The rail's running head: this page's section, or the role for the home page. */
const path = head.path ?? '/';
const section =
  path === '/' ? site.role : (nav.find((n) => n.href !== '/' && path.startsWith(n.href))?.label ?? site.role);
---

<!doctype html>
<html lang="en" class="scroll-pt-24" data-email={site.email}>
  <head>
    <BaseHead {...head} />
    <script is:inline>
      // Runs before first paint: resolves the stored theme so there is no flash.
      (() => {
        let pref = 'system';
        try {
          pref = localStorage.getItem('theme') || 'system';
        } catch {
          /* storage blocked — fall through to system */
        }
        const isDark =
          pref === 'dark' || (pref === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', isDark);
        document.documentElement.dataset.theme = pref;
        document.documentElement.classList.add('js');
        // The browser chrome follows a chosen theme. Each tag keeps its own
        // colour in data-tint, so the toggle can hand back to `system`.
        const metas = [...document.querySelectorAll('meta[name="theme-color"]')];
        for (const m of metas) m.dataset.tint = m.content;
        const chosen = metas.find((m) => m.media.includes(pref));
        if (pref !== 'system' && chosen) for (const m of metas) m.content = chosen.dataset.tint;
      })();
    </script>
  </head>
  <body class="min-h-dvh antialiased">
    <Header />
    <div class="rail-vertical hidden xl:block" aria-hidden="true">{section} — {site.name}</div>
    <main id="main">
      <slot />
    </main>
    {!bareFooter && <Footer />}
    <CommandPalette />
    <EasterEggs />

    <script>
      import { $$ } from '@/lib/client/dom';
      import { mayMove } from '@/lib/client/env';
      import { follow } from '@/lib/client/follow';

      /* Visible by default; this opts below-the-fold elements in, so a failed
         script can never leave content hidden. */
      if (mayMove() && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0 },
        );
        // A viewport change can bring elements into view without any scroll.
        const arm = () => {
          const fold = window.innerHeight * 0.92;
          for (const el of $$('[data-reveal]:not(.reveal-pending), [data-draw]:not(.draw-pending)')) {
            // Anything already on screen stays put — no stutter on first paint.
            if (el.getBoundingClientRect().top <= fold) continue;
            // A rule draws in; everything else fades up. Same observer.
            el.classList.add(el.hasAttribute('data-draw') ? 'draw-pending' : 'reveal-pending');
            io.observe(el);
          }
        };
        arm();
        window.addEventListener('resize', arm, { passive: true });
      }

      /* data-lean shortens the transition while tracking; without it the lean
         trailed the cursor by 250ms. */
      const REACH = 5; // px, at the button's edge
      follow(
        '.btn',
        (btn, x, y) => {
          btn.setAttribute('data-lean', '');
          btn.style.translate = `${((x - 0.5) * 2 * REACH).toFixed(1)}px ${((y - 0.5) * 2 * REACH).toFixed(1)}px`;
        },
        (btn) => {
          btn.removeAttribute('data-lean');
          btn.style.translate = '';
        },
      );
    </script>
  </body>
</html>
