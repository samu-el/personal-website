---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CommandPalette from '@/components/CommandPalette.astro';
import EasterEggs from '@/components/EasterEggs.astro';
import { nav, site } from '@/lib/site';

interface Props {
  title: string;
  description?: string;
  path?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  /** Drops the footer CTA — used on the contact page, where it would repeat. */
  bareFooter?: boolean;
}

const { bareFooter = false, ...head } = Astro.props;

/**
 * Running head for the vertical rail: the section this page belongs to. A
 * project or post page takes its section's name; the home page takes the
 * role, since "Home" says nothing.
 */
const path = head.path ?? '/';
const section =
  path === '/'
    ? site.role
    : (nav.find((n) => n.href !== '/' && path.startsWith(n.href))?.label ?? site.role);
---

<!doctype html>
<html lang="en" class="scroll-pt-24">
  <head>
    <BaseHead {...head} />
    <script is:inline>
      // Runs before first paint: resolves the stored theme so there is no flash.
      (() => {
        let pref = 'system';
        try {
          pref = localStorage.getItem('theme') || 'system';
        } catch {
          /* storage blocked — fall through to system */
        }
        const isDark =
          pref === 'dark' ||
          (pref === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', isDark);
        document.documentElement.dataset.theme = pref;
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body class="min-h-dvh antialiased">
    <Header />
    <div class="rail-vertical hidden xl:block" aria-hidden="true">{section} — {site.name}</div>
    <main id="main">
      <slot />
    </main>
    {!bareFooter && <Footer />}
    <CommandPalette />
    <EasterEggs />

    <script is:inline>
      // Progressive scroll reveal. Content is visible by default; the script
      // opts individual below-the-fold elements into the animation, so a failed
      // or blocked script can never leave content hidden.
      (() => {
        let io;

        function arm() {
          if (
            window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
            !('IntersectionObserver' in window)
          ) {
            return;
          }

          io =
            io ||
            new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (!entry.isIntersecting) continue;
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              },
              { rootMargin: '0px 0px -6% 0px', threshold: 0 },
            );

          const fold = window.innerHeight * 0.92;
          const pending = '[data-reveal]:not(.reveal-pending), [data-draw]:not(.draw-pending)';
          for (const el of document.querySelectorAll(pending)) {
            // Anything already on screen stays put — no stutter on first paint.
            if (el.getBoundingClientRect().top <= fold) continue;
            // A rule draws in; everything else fades up. Same observer.
            el.classList.add(el.hasAttribute('data-draw') ? 'draw-pending' : 'reveal-pending');
            io.observe(el);
          }
        }

        function init() {
          arm();
          // A viewport change can bring elements into view without any scroll.
          window.addEventListener('resize', arm, { passive: true });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
        document.addEventListener('astro:page-load', init);
      })();
    </script>

    <script is:inline>
      // Buttons lean toward the cursor — a few pixels, on a spring — and
      // settle back when it leaves. One delegated listener for every button
      // on the page, and none of it for touch, coarse pointers or anyone who
      // asked for less motion.
      (() => {
        const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
        const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
        const REACH = 5; // px, at the button's edge

        document.addEventListener(
          'pointermove',
          (e) => {
            if (!fine.matches || calm.matches) return;
            const btn = e.target instanceof Element ? e.target.closest('.btn') : null;
            if (!btn) return;
            const box = btn.getBoundingClientRect();
            const x = ((e.clientX - box.left) / box.width - 0.5) * 2 * REACH;
            const y = ((e.clientY - box.top) / box.height - 0.5) * 2 * REACH;
            // data-lean shortens the transition while the pointer is on the
            // button; without it the lean trailed the cursor by 250ms.
            btn.setAttribute('data-lean', '');
            btn.style.translate = `${x.toFixed(1)}px ${y.toFixed(1)}px`;
          },
          { passive: true },
        );
        document.addEventListener(
          'pointerout',
          (e) => {
            const btn = e.target instanceof Element ? e.target.closest('.btn') : null;
            if (btn && !(e.relatedTarget instanceof Node && btn.contains(e.relatedTarget))) {
              // Long ease back, so releasing settles rather than snapping.
              btn.removeAttribute('data-lean');
              btn.style.translate = '';
            }
          },
          { passive: true },
        );
      })();
    </script>
  </body>
</html>
