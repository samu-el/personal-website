---
import { site, socials } from '@/lib/site';
import { href } from '@/lib/paths';
import { hasWriting, visibleNav } from '@/lib/posts';
import { Icon } from 'astro-icon/components';

const year = new Date().getFullYear();

const writing = await hasWriting();
const items = await visibleNav();
---

<footer id="site-footer" class="border-t border-line bg-sunken">
  <div class="wrap pb-10 pt-20 lg:pb-12 lg:pt-28">
    <!-- A statement close: the one line, then the address itself as the action. -->
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-8">
      <div class="lg:col-span-7">
        <h2 class="display-xl text-display-s">Reach out.</h2>
        <a
          href={`mailto:${site.email}`}
          class="link display mt-6 inline-block text-[clamp(1.75rem,3.2vw,2.75rem)] lg:mt-8"
        >
          {site.email}
        </a>
      </div>
      <div class="flex flex-wrap gap-3 lg:col-span-5 lg:justify-end">
        <a href={href('/contact')} class="btn btn-ghost">
          <Icon name="lucide:mail" class="size-4" aria-hidden="true" />
          Contact
        </a>
      </div>
    </div>

    <!-- Link lists, ruled. No headings: page names and network names say
         what they are. Navs, so each list is still named for a screen reader. -->
    <div
      class="mt-16 grid grid-cols-2 gap-x-6 gap-y-10 border-t border-line pt-10 lg:mt-20 lg:grid-cols-12 lg:gap-8 lg:pt-12"
    >
      <nav aria-label="Pages" class="lg:col-span-4">
        <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
          {
            items.map((item) => (
              <li>
                <a href={href(item.href)} class="hit text-[0.9375rem] text-muted transition-colors hover:text-fg">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-label="Elsewhere" class="lg:col-span-3 lg:col-start-6">
        <ul class="space-y-3">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  class="hit group inline-flex items-center gap-2.5 text-[0.9375rem] text-muted transition-colors hover:text-fg"
                  rel={s.href.startsWith('http') ? 'noopener noreferrer me' : undefined}
                  target={s.href.startsWith('http') ? '_blank' : undefined}
                >
                  <Icon name={s.icon} class="size-4 shrink-0" aria-hidden="true" />
                  {s.label}
                </a>
              </li>
            ))
          }
          {
            writing && (
              <li>
                <a
                  href={href('/rss.xml')}
                  class="hit inline-flex items-center gap-2.5 text-[0.9375rem] text-muted transition-colors hover:text-fg"
                >
                  <Icon name="lucide:rss" class="size-4 shrink-0" aria-hidden="true" />
                  RSS
                </a>
              </li>
            )
          }
        </ul>
      </nav>
      <!-- Where he is, and the time there: two lines, no separator glyph. -->
      <div class="col-span-2 space-y-3 text-[0.9375rem] lg:col-span-3 lg:col-start-10 lg:text-right">
        <p class="text-fg">{site.location}</p>
        <p class="tabular-nums text-muted"><time id="local-time" datetime="">EAT</time></p>
      </div>
    </div>

    <p class="meta mt-16 lg:mt-20">© {year} {site.name}</p>
  </div>
</footer>

<script>
  import { byId } from '@/lib/client/dom';

  /* The clock in the footer, in his time rather than the reader's. */
  const el = byId('local-time');
  if (el) {
    const format = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Africa/Addis_Ababa',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    const tick = () => {
      const now = new Date();
      el.textContent = `${format.format(now)} EAT`;
      el.setAttribute('datetime', now.toISOString());
    };
    tick();
    setInterval(tick, 30000);
  }
</script>
