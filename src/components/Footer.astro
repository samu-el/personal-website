---
import { site, socials } from '@/lib/site';
import { href } from '@/lib/paths';
import { hasWriting, visibleNav } from '@/lib/posts';
import { Icon } from 'astro-icon/components';

const year = new Date().getFullYear();

const writing = await hasWriting();
const items = await visibleNav();
---

<footer id="site-footer" class="mt-8 border-t border-line bg-sunken lg:mt-12">
  <div class="wrap py-12 lg:py-20">
    <!-- Call to action: the one line, at the size it deserves. -->
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-8">
      <div class="lg:col-span-8">
        <h2 class="display-hero text-[clamp(2.4rem,6.4vw,5rem)]">Reach out.</h2>
      </div>
      <div class="flex flex-wrap gap-3 lg:col-span-4 lg:justify-end">
        <a href={`mailto:${site.email}`} class="btn btn-primary">
          <Icon name="lucide:mail" class="size-4" aria-hidden="true" />
          {site.email}
        </a>
        <a href={href('/contact')} class="btn btn-ghost">Contact</a>
      </div>
    </div>

    <!-- Link columns, ruled. No column headings: page names and network names
         say what they are. Navs, so each list is still named for a screen reader. -->
    <div
      class="mt-12 grid grid-cols-2 gap-x-6 gap-y-10 border-t border-line pt-10 lg:mt-16 lg:grid-cols-12 lg:gap-8 lg:pt-12"
    >
      <!-- Columns end on the twelfth, flush with the buttons above them. -->
      <nav aria-label="Pages" class="lg:col-span-3 lg:col-start-8">
        <ul class="space-y-2.5">
          {
            items.map((item) => (
              <li>
                <a
                  href={href(item.href)}
                  class="hit inline-flex items-baseline gap-2.5 text-sm text-muted transition-colors hover:text-fg"
                >
                  <span class="font-mono text-2xs text-subtle">{item.index}</span>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-label="Elsewhere" class="lg:col-span-2">
        <ul class="space-y-2.5">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  class="hit group inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-fg"
                  rel={s.href.startsWith('http') ? 'noopener noreferrer me' : undefined}
                  target={s.href.startsWith('http') ? '_blank' : undefined}
                >
                  <Icon name={s.icon} class="size-3.5 shrink-0 opacity-70" aria-hidden="true" />
                  {s.label}
                </a>
              </li>
            ))
          }
          {
            writing && (
              <li>
                <a
                  href={href('/rss.xml')}
                  class="hit inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-fg"
                >
                  <Icon name="lucide:rss" class="size-3.5 shrink-0 opacity-70" aria-hidden="true" />
                  RSS
                </a>
              </li>
            )
          }
        </ul>
      </nav>
    </div>
    <div class="rule mt-10 lg:mt-14"></div>

    <div
      class="mt-6 flex flex-col gap-3 font-mono text-2xs tracking-wide text-subtle sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.name}. All rights reserved.</p>
      <p class="flex items-center gap-2">
        <span class="inline-block size-1.5 rounded-full bg-jade" aria-hidden="true"></span>
        <span>{site.location}</span>
        <span aria-hidden="true" class="text-line-strong">/</span>
        <span><time id="local-time" datetime="">EAT</time></span>
      </p>
    </div>
  </div>
</footer>

<script>
  import { byId } from '@/lib/client/dom';

  /* The clock in the footer, in his time rather than the reader's. */
  const el = byId('local-time');
  if (el) {
    const format = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Africa/Addis_Ababa',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    const tick = () => {
      const now = new Date();
      el.textContent = `${format.format(now)} EAT`;
      el.setAttribute('datetime', now.toISOString());
    };
    tick();
    setInterval(tick, 30000);
  }
</script>
