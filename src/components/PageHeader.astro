---
/**
 * The header block every inner page opens with: index eyebrow, a display
 * headline, and an aside column for the one-line description — over the
 * twelve-column hairlines the layout is built on, with the page's index set
 * huge and faint behind it.
 *
 * One component so the pages cannot drift from each other, and so the
 * watermark, the grid and the reveal timings are decided once.
 */
interface Props {
  /** Two-digit index from the nav, e.g. "02". Also the watermark. */
  index?: string;
  /** Eyebrow label, e.g. "About". */
  label: string;
  /** Tighter vertical rhythm for pages whose body starts with a big element. */
  compact?: boolean;
}

const { index, label, compact = false } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class="relative overflow-hidden border-b border-line">
  <div class="pointer-events-none absolute inset-0 grid-lines-12 opacity-50" aria-hidden="true">
  </div>
  <div class:list={['wrap relative', compact ? 'py-10 lg:py-16' : 'py-10 lg:py-24']}>
    {
      index && (
        <span class="rail-index" aria-hidden="true">
          {index}
        </span>
      )
    }

    <p class="eyebrow relative" data-reveal>
      {index && <span class="text-accent">{index}</span>}
      {label}
    </p>

    <div class="relative mt-6 grid gap-6 lg:mt-8 lg:grid-cols-12 lg:gap-8">
      <div class:list={[hasAside ? 'lg:col-span-8' : 'lg:col-span-12']}>
        <h1
          class="display-hero text-[clamp(2.6rem,7.2vw,5.5rem)]"
          data-reveal
          style="--reveal-delay:60ms"
        >
          <slot />
        </h1>
      </div>
      {
        hasAside && (
          <div class="lg:col-span-4 lg:col-start-9 lg:self-end">
            <div
              class="border-l border-line pl-5 text-[0.9375rem] leading-relaxed text-muted lg:text-base"
              data-reveal
              style="--reveal-delay:120ms"
            >
              <slot name="aside" />
            </div>
          </div>
        )
      }
    </div>

    <slot name="after" />
  </div>
</section>
