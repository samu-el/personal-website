---
import { Icon } from 'astro-icon/components';
import { href } from '@/lib/paths';

/** The one way back out of a detail page. */
interface Props {
  to: string;
  label: string;
}
const { to, label } = Astro.props as Props;
---

<nav aria-label="Breadcrumb" class="mb-6 lg:mb-10">
  <a href={href(to)} class="group inline-flex items-center gap-2 meta transition-colors hover:text-fg">
    <Icon
      name="lucide:arrow-left"
      class="size-3 transition-transform duration-300 group-hover:-translate-x-0.5"
      aria-hidden="true"
    />
    {label}
  </a>
</nav>
