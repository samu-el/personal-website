---
import { href } from '@/lib/paths';

/** The one way back out of a detail page. */
interface Props {
  to: string;
  label: string;
}
const { to, label } = Astro.props as Props;
---

<nav aria-label="Breadcrumb" class="mb-6 lg:mb-10">
  <!-- The label carries the direction; .hit for a thumb. -->
  <a href={href(to)} class="hit meta transition-colors hover:text-fg">
    {label}
  </a>
</nav>
