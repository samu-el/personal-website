---
/**
 * A screenshot of a project actually running, shared by the home page, the
 * /work rows and each detail page. Assets are matched by project id, so
 * dropping a file in is all it takes (`npm run shots` refreshes them) and a
 * missing one degrades to the fallback below. docs/architecture.md,
 * "Screenshots".
 *
 * The capture is the picture: no drawn browser bar or phone bezel around it,
 * only the theme's radius and an inset outline. A project with a live site
 * links the picture there.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { byId as pickAsset } from '@/lib/assets';

interface Props {
  project: CollectionEntry<'projects'>;
  /** The first frame on a page should not be lazy, and is fetched first. */
  eager?: boolean;
  /** How wide the frame renders; defaults to the /work row's layout. */
  sizes?: string;
  /** Crops a desktop capture to another ratio, from the top. */
  aspect?: string;
  class?: string;
}

const previews = import.meta.glob<{ default: ImageMetadata }>('/src/assets/previews/*.{png,jpg,jpeg,webp,avif}', {
  eager: true,
});

const { project, eager = false, sizes: sizesProp, aspect: aspectProp, class: className } = Astro.props;
const { title, demo, device } = project.data;

const preview = pickAsset(previews, project.id);
const phone = device === 'phone';
const sizes = sizesProp ?? (phone ? '19rem' : '(min-width: 1024px) 58vw, 100vw');

/** Hostname only. A full URL is noise at this type size. */
const host = demo ? new URL(demo).host : null;
/** Only a link when there is somewhere else to go, never to this same page. */
const Tag = demo ? 'a' : 'div';
const linkAttrs = demo
  ? {
      href: demo,
      target: '_blank',
      rel: 'noopener noreferrer',
      'aria-label': `${title}: open ${host} in a new tab`,
    }
  : {};

/** Matches the viewport scripts/shots.mjs captures at, unless a crop is asked for. */
const aspect = aspectProp ?? (phone ? 'aspect-[440/936]' : 'aspect-[16/10]');
---

<div class:list={['relative', phone && 'mx-auto w-full max-w-[19rem]', className]}>
  <Tag
    {...linkAttrs}
    class:list={['shot', phone && 'shot-phone', aspect]}
    data-slot={`shot-${project.id}`}
    data-kind="product"
    data-alt={`${title}, its main screen`}
  >
    {
      preview ? (
        <Image
          src={preview}
          alt={`${title}, running`}
          widths={phone ? [320, 480, 880] : [640, 960, 1280, 1600]}
          {sizes}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
          decoding="async"
          class="size-full object-cover object-top"
        />
      ) : (
        /* No screenshot yet: the title, never a stand-in that pretends to be
           a picture of the product. */
        <div class="absolute inset-0 grid place-items-center">
          <p class="display relative px-6 text-center text-title text-subtle">{title}</p>
        </div>
      )
    }
  </Tag>
</div>
