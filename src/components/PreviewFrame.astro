---
/**
 * A screenshot of a project actually running, shared by the home page, the
 * /work rows and each detail page, in the site's current theme. Assets are
 * matched by project id (`<id>.webp`, plus `<id>-dark.webp` for a product
 * with both looks), so dropping files in is all it takes (`npm run shots`
 * refreshes them) and a missing one degrades to the fallback below.
 * docs/architecture.md, "Screenshots".
 *
 * The capture is the picture: no drawn browser bar or phone bezel around it,
 * only the theme's radius and an inset outline. A project with a live site
 * links the picture there.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { previewsFor } from '@/lib/previews';

interface Props {
  project: CollectionEntry<'projects'>;
  /** The first frame on a page is fetched first. With a light and dark pair,
   *  the page also hands Layout its `previewPreloads()`. */
  eager?: boolean;
  /** How wide a desktop frame renders (src/lib/previews.ts). */
  sizes?: string;
  /** Crops a desktop capture to another ratio, from the top. */
  aspect?: string;
  class?: string;
}

const { project, eager = false, sizes, aspect: aspectProp, class: className } = Astro.props;
const { title, demo, device } = project.data;

const previews = previewsFor(project, sizes);
const phone = device === 'phone';
const alt = `${title}, running`;

/** Hostname only. A full URL is noise at this type size. */
const host = demo ? new URL(demo).host : null;
/** Only a link when there is somewhere else to go, never to this same page. */
const Tag = demo ? 'a' : 'div';
const linkAttrs = demo
  ? {
      href: demo,
      target: '_blank',
      rel: 'noopener noreferrer',
      'aria-label': `${title}: open ${host} in a new tab`,
    }
  : {};

/** Matches the viewport scripts/shots.mjs captures at, unless a crop is asked for. */
const aspect = aspectProp ?? (phone ? 'aspect-[440/936]' : 'aspect-[16/10]');
---

<div class:list={['relative', phone && 'mx-auto w-full max-w-[19rem]', className]}>
  <Tag
    {...linkAttrs}
    class:list={['shot', phone && 'shot-phone', aspect]}
    data-slot={`shot-${project.id}`}
    data-kind="product"
    data-alt={`${title}, its main screen`}
  >
    {
      previews?.dark ? (
        /* Light and dark captures: components.css shows the one matching the
           root element's theme class and sets the other to display:none, which
           a lazy image never fetches. Both are lazy for that reason; an eager
           frame's early fetch is the preload the theme script picks
           (src/lib/previews.ts). */
        <>
          <Image
            {...previews.light}
            {alt}
            loading="lazy"
            fetchpriority={eager ? 'high' : undefined}
            decoding="async"
            class="shot-light size-full object-cover object-top"
          />
          <Image
            {...previews.dark}
            {alt}
            loading="lazy"
            fetchpriority={eager ? 'high' : undefined}
            decoding="async"
            class="shot-dark size-full object-cover object-top"
          />
        </>
      ) : previews ? (
        <Image
          {...previews.light}
          {alt}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
          decoding="async"
          class="size-full object-cover object-top"
        />
      ) : (
        /* No screenshot yet: the title, never a stand-in that pretends to be
           a picture of the product. */
        <div class="absolute inset-0 grid place-items-center">
          <p class="display relative px-6 text-center text-title text-subtle">{title}</p>
        </div>
      )
    }
  </Tag>
</div>
