---
/**
 * The /work treatment, one block per project, led by a screenshot of the thing
 * running. A desktop capture runs the full width under its title, with the
 * write-up and the facts beneath; a phone capture stands beside them. Assets
 * are matched by project id, so dropping a file in is all it takes.
 * docs/architecture.md, "Screenshots".
 */
import Chips from '@/components/Chips.astro';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { byId as pickAsset } from '@/lib/assets';
import { Icon } from 'astro-icon/components';
import { href } from '@/lib/paths';
import { tone } from '@/lib/status';
import PreviewFrame from '@/components/PreviewFrame.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const logos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/logos/*.{png,jpg,jpeg,webp,avif}', {
  eager: true,
});

const { project, index } = Astro.props;
const { title, blurb, period, kind, role, status, stack, demo, repo, stats } = project.data;

const logo = pickAsset(logos, project.id);

const phone = project.data.device === 'phone';

/** Stands in for a missing logo: the initial, saying nothing the title does not. */
const monogram = (title.replace(/[^A-Za-z]/g, '')[0] ?? '·').toUpperCase();

const detail = href(`/work/${project.id}`);
---

<article class="relative" data-reveal style={`--reveal-delay:${Math.min(index, 4) * 60}ms`}>
  <!-- Title row: the mark, the name, and the facts as separate cells. -->
  <header class="grid items-end gap-6 border-b border-line pb-6 lg:grid-cols-12 lg:gap-8">
    <div class="flex min-w-0 items-center gap-4 lg:col-span-7">
      <!-- The project's mark, or its initial styled as chosen typography
           rather than a picture that failed to load. -->
      <span
        class:list={[
          'grid size-12 shrink-0 place-items-center overflow-hidden rounded-lg border',
          // A light plate in both themes: these marks were drawn for a light
          // ground, and fantasy.et's dark purple vanished on the dark one.
          logo ? 'border-line bg-plate' : 'border-line bg-surface-2',
        ]}
        aria-hidden="true"
      >
        {
          logo ? (
            /* Its own size: these are favicons, and asking for more pixels
               than the source has upscales it twice. */
            <Image src={logo} alt="" width={logo.width} height={logo.height} class="size-full object-contain" />
          ) : (
            <span class="display text-xl leading-none text-accent">{monogram}</span>
          )
        }
      </span>
      <h2 class="display min-w-0 text-section" style={`view-transition-name:project-${project.id}`}>
        <a href={detail} class="link">{title}</a>
      </h2>
    </div>
    <dl class="grid grid-cols-3 gap-6 text-[0.9375rem] lg:col-span-5">
      <div>
        <dt class="sr-only">Kind</dt>
        <dd class="text-fg">{kind}</dd>
      </div>
      <div>
        <dt class="sr-only">Period</dt>
        <dd class="tabular-nums text-muted">{period}</dd>
      </div>
      <div class="text-right">
        <dt class="sr-only">Status</dt>
        <dd class={tone(status)}>{status}</dd>
      </div>
    </dl>
  </header>

  <div class:list={['mt-10 grid gap-10 lg:grid-cols-12 lg:gap-8', phone ? 'lg:items-center' : '']}>
    <div class:list={[phone ? 'lg:col-span-4' : 'lg:col-span-12']}>
      <PreviewFrame {project} eager={index === 0} sizes={phone ? '19rem' : '(min-width: 1440px) 1312px, 92vw'} />
    </div>

    <div
      class:list={['grid gap-10', phone ? 'lg:col-span-7 lg:col-start-6' : 'lg:col-span-12 lg:grid-cols-12 lg:gap-8']}
    >
      <div class:list={[!phone && 'lg:col-span-6']}>
        <p class="lead text-muted">{blurb}</p>
        <p class="meta mt-5">{role}</p>
      </div>

      <div class:list={[!phone && 'lg:col-span-5 lg:col-start-8']}>
        {
          stats.length > 0 && (
            <dl class="ledger text-[0.9375rem]">
              {stats.map((s) => (
                <div class="flex justify-between gap-4 py-3">
                  <dt class="text-subtle">{s.label}</dt>
                  <dd class="text-right text-fg">{s.value}</dd>
                </div>
              ))}
            </dl>
          )
        }

        <Chips items={stack.slice(0, 6)} label="Stack" class="mt-6" />

        {
          (demo || repo) && (
            <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2">
              {demo && (
                <a
                  href={demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hit inline-flex items-center gap-2 text-[0.9375rem] text-muted transition-colors hover:text-accent"
                >
                  <Icon name="lucide:external-link" class="size-4" aria-hidden="true" />
                  Live
                </a>
              )}
              {repo && (
                <a
                  href={repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hit inline-flex items-center gap-2 text-[0.9375rem] text-muted transition-colors hover:text-accent"
                >
                  <Icon name="simple-icons:github" class="size-4" aria-hidden="true" />
                  Source
                </a>
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
</article>
