---
/**
 * The /work treatment: one generous, alternating row per project, led by a
 * screenshot of the thing actually running.
 *
 * Assets are matched by project id rather than named in frontmatter. Dropping
 * src/assets/previews/jeopardy.png in is all it takes, a missing file degrades
 * to the fallback below instead of failing the build, and nothing in the
 * content files has to be kept in sync with the filesystem. Screenshots come
 * from scripts/shots.mjs, which needs network access to the live sites.
 */
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { href } from '@/lib/paths';
import PreviewFrame from '@/components/PreviewFrame.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const logos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/logos/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);

/**
 * Matches `<id>.<ext>` at the end of a glob key, ignoring the extension.
 *
 * Written without a regex on purpose. The obvious version — a character class
 * containing a slash, then a template literal starting with one — parses as
 * valid TypeScript but breaks prettier-plugin-astro's tokenizer, which then
 * runs past the closing fence and reports dozens of phantom errors across the
 * template. Either construct alone is fine; together they are not.
 */
function pick(map: Record<string, { default: ImageMetadata }>, id: string) {
  const suffix = '/' + id;
  const hit = Object.entries(map).find(([path]) => {
    const dot = path.lastIndexOf('.');
    return (dot === -1 ? path : path.slice(0, dot)).endsWith(suffix);
  });
  return hit?.[1].default;
}

const { project, index } = Astro.props;
const { title, blurb, period, kind, role, status, stack, demo, repo, repoPrivate, stats } =
  project.data;

const logo = pick(logos, project.id);

/** Rows alternate, so the page reads as a column rather than a stack. */
const flip = index % 2 === 1;

/**
 * Stands in for a missing logo: the project's own initial in the display face.
 * Typographic rather than invented — it says nothing that is not already the
 * title, which is the point.
 */
const monogram = (title.replace(/[^A-Za-z]/g, '')[0] ?? '·').toUpperCase();

const detail = href(`/work/${project.id}`);
---

<article
  class="group/row relative"
  data-reveal
  style={`--reveal-delay:${Math.min(index, 4) * 80}ms`}
>
  <div class="grid items-center gap-7 lg:grid-cols-12 lg:gap-12">
    <!-- ── Preview ──────────────────────────────────────────────────── -->
    <div class:list={['lg:col-span-7', flip && 'lg:order-2']}>
      <PreviewFrame {project} eager={index === 0} />
    </div>

    <!-- ── Detail ───────────────────────────────────────────────────── -->
    <div class:list={['lg:col-span-5', flip && 'lg:order-1']}>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
        <span class="font-mono text-2xs uppercase tracking-[0.12em] text-subtle">{kind}</span>
        <span class="text-line-strong" aria-hidden="true">·</span>
        <span class="font-mono text-2xs tracking-wide text-subtle">{period}</span>
        {
          (status === 'Live' || status === 'Ongoing') && (
            <span class="ml-auto flex shrink-0 items-center gap-1.5 font-mono text-2xs uppercase tracking-[0.1em] text-jade">
              <span class="relative flex size-1.5">
                <span class="absolute inline-flex size-full animate-ping rounded-full bg-jade opacity-60" />
                <span class="relative inline-flex size-1.5 rounded-full bg-jade" />
              </span>
              {status}
            </span>
          )
        }
      </div>

      <div class="mt-5 flex items-center gap-3.5">
        <!--
          The project's own mark where one exists, otherwise its initial set in
          the site's display face. The initial is styled to read as chosen
          typography rather than a picture that failed to load: accent ink on a
          tinted tile, optically centred.
        -->
        <span
          class:list={[
            'grid size-11 shrink-0 place-items-center overflow-hidden rounded-lg border',
            // A logo gets a light plate in both themes, not the surface colour.
            // These marks come from favicons with transparent backgrounds and
            // were drawn for a light ground: fantasy.et's is dark purple, and
            // on the dark theme's near-black surface it disappeared entirely.
            // An icon well is also just how an app icon is normally presented.
            logo ? 'border-line bg-[rgb(250_248_245)]' : 'border-accent/25 bg-accent/[0.07]',
          ]}
          aria-hidden="true"
        >
          {
            logo ? (
              /* Emitted at its own size rather than a fixed 88: these come
                 from favicons, and asking for more pixels than the source has
                 just upscales it before the browser scales it again. */
              <Image
                src={logo}
                alt=""
                width={logo.width}
                height={logo.height}
                class="size-full object-contain"
              />
            ) : (
              <span class="display text-xl leading-none text-accent">{monogram}</span>
            )
          }
        </span>

        <h2
          class="display min-w-0 flex-1 text-[clamp(1.5rem,3vw,2.125rem)] leading-tight"
          style={`view-transition-name:project-${project.id}`}
        >
          <a href={detail} class="group/link">
            <span class="link">{title}</span>
            <Icon
              name="lucide:arrow-right"
              class="ml-0.5 inline-block size-[0.7em] -translate-y-px text-subtle transition-transform duration-300 group-hover/link:translate-x-1 group-hover/link:text-accent"
              aria-hidden="true"
            />
          </a>
        </h2>
      </div>

      <p class="mt-4 leading-relaxed text-muted">{blurb}</p>

      <p class="mt-4 font-mono text-2xs uppercase tracking-[0.1em] text-subtle">{role}</p>

      {
        stats.length > 0 && (
          <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-md border border-line bg-line [&>*:last-child:nth-child(odd)]:col-span-2">
            {stats.map((s) => (
              <div class="bg-surface-2 px-3.5 py-3">
                <dt class="font-mono text-2xs uppercase tracking-[0.12em] text-subtle">
                  {s.label}
                </dt>
                <dd class="mt-1 text-[0.9375rem] leading-snug tracking-tight text-fg">{s.value}</dd>
              </div>
            ))}
          </dl>
        )
      }

      {
        stack.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Stack">
            {stack.slice(0, 6).map((s) => (
              <li class="chip">{s}</li>
            ))}
          </ul>
        )
      }

      {
        (demo || repo || repoPrivate) && (
          <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-line pt-5">
            {demo && (
              <a
                href={demo}
                target="_blank"
                rel="noopener noreferrer"
                class="hit inline-flex items-center gap-1.5 font-mono text-2xs uppercase tracking-[0.1em] text-muted transition-colors hover:text-accent"
              >
                <Icon name="lucide:external-link" class="size-3" aria-hidden="true" />
                Live
              </a>
            )}
            {repo && (
              <a
                href={repo}
                target="_blank"
                rel="noopener noreferrer"
                class="hit inline-flex items-center gap-1.5 font-mono text-2xs uppercase tracking-[0.1em] text-muted transition-colors hover:text-accent"
              >
                <Icon name="simple-icons:github" class="size-3" aria-hidden="true" />
                Source
              </a>
            )}
            {!repo && repoPrivate && (
              <span class="inline-flex items-center gap-1.5 font-mono text-2xs uppercase tracking-[0.1em] text-subtle">
                <Icon name="lucide:lock" class="size-3" aria-hidden="true" />
                Private source
              </span>
            )}
          </div>
        )
      }
    </div>
  </div>
</article>
