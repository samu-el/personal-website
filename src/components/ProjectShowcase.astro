---
/**
 * The /work treatment: one generous, alternating row per project, led by a
 * screenshot of the thing actually running.
 *
 * Assets are matched by project id rather than named in frontmatter. Dropping
 * src/assets/previews/jeopardy.png in is all it takes, a missing file degrades
 * to the fallback below instead of failing the build, and nothing in the
 * content files has to be kept in sync with the filesystem. Screenshots come
 * from scripts/shots.mjs, which needs network access to the live sites.
 */
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { href } from '@/lib/paths';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const previews = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/previews/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
const logos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/logos/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);

/**
 * Matches `<id>.<ext>` at the end of a glob key, ignoring the extension.
 *
 * Written without a regex on purpose. The obvious version — a character class
 * containing a slash, then a template literal starting with one — parses as
 * valid TypeScript but breaks prettier-plugin-astro's tokenizer, which then
 * runs past the closing fence and reports dozens of phantom errors across the
 * template. Either construct alone is fine; together they are not.
 */
function pick(map: Record<string, { default: ImageMetadata }>, id: string) {
  const suffix = '/' + id;
  const hit = Object.entries(map).find(([path]) => {
    const dot = path.lastIndexOf('.');
    return (dot === -1 ? path : path.slice(0, dot)).endsWith(suffix);
  });
  return hit?.[1].default;
}

const { project, index } = Astro.props;
const { title, blurb, period, kind, role, status, stack, demo, repo, repoPrivate, stats } =
  project.data;

const preview = pick(previews, project.id);
const logo = pick(logos, project.id);

/** Rows alternate, so the page reads as a column rather than a stack. */
const flip = index % 2 === 1;

/** Hostname only. A full URL is noise at this type size. */
const host = demo ? new URL(demo).host : null;

/**
 * Stands in for a missing logo: the project's own initial in the display face.
 * Typographic rather than invented — it says nothing that is not already the
 * title, which is the point.
 */
const monogram = (title.replace(/[^A-Za-z]/g, '')[0] ?? '·').toUpperCase();

const detail = href(`/work/${project.id}`);
---

<article
  class="group/row relative"
  data-reveal
  style={`--reveal-delay:${Math.min(index, 4) * 80}ms`}
>
  <div class="grid items-center gap-7 lg:grid-cols-12 lg:gap-12">
    <!-- ── Preview ──────────────────────────────────────────────────── -->
    <div class:list={['lg:col-span-7', flip && 'lg:order-2']}>
      <div class="relative" data-frame>
        <!--
          Warmth behind the frame, positioned from the cursor. Same radial
          idiom as the now-playing card, so the two read as one system.
        -->
        <div
          class="pointer-events-none absolute -inset-6 opacity-0 blur-3xl transition-opacity duration-700 group-hover/row:opacity-100"
          style="background:radial-gradient(45% 45% at var(--mx,50%) var(--my,40%),rgb(var(--c-accent)/0.3),transparent 70%)"
          aria-hidden="true"
        >
        </div>

        <a
          href={demo ?? detail}
          target={demo ? '_blank' : undefined}
          rel={demo ? 'noopener noreferrer' : undefined}
          aria-label={demo ? `${title} — open ${host} in a new tab` : `${title} — read more`}
          class="card relative block overflow-hidden rounded-xl group-hover/row:-translate-y-1"
        >
          <!--
            Browser chrome, and the hostname in it is the real one. The frame
            says "this is a running site" without the screenshot having to
            carry that on its own.
          -->
          <div
            class="flex items-center gap-2.5 border-b border-line bg-surface-2 px-3.5 py-2.5 sm:px-4"
          >
            <span class="flex shrink-0 gap-1.5" aria-hidden="true">
              <span class="size-2 rounded-full bg-line-strong"></span>
              <span class="size-2 rounded-full bg-line-strong"></span>
              <span class="size-2 rounded-full bg-line-strong"></span>
            </span>
            <span
              class="min-w-0 flex-1 truncate font-mono text-2xs tracking-wide text-subtle transition-colors group-hover/row:text-muted"
            >
              {host ?? project.id}
            </span>
            {
              demo && (
                <Icon
                  name="lucide:arrow-up-right"
                  class="size-3 shrink-0 text-subtle transition-all duration-300 group-hover/row:-translate-y-0.5 group-hover/row:translate-x-0.5 group-hover/row:text-accent"
                  aria-hidden="true"
                />
              )
            }
          </div>

          <!-- Fixed ratio so the row does not reflow as the image decodes. -->
          <div class="relative aspect-[16/10] overflow-hidden bg-surface-2">
            {
              preview ? (
                <Image
                  src={preview}
                  alt={`${title}, running`}
                  widths={[640, 960, 1280, 1600]}
                  sizes="(min-width: 1024px) 58vw, 100vw"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="size-full object-cover object-top transition-transform duration-[900ms] ease-out-quint group-hover/row:scale-[1.035]"
                />
              ) : (
                /* No screenshot committed yet. The site's own grid texture and
                   the title, rather than a fake window or a stock image —
                   nothing here pretends to be a picture of the product. */
                <div class="absolute inset-0 grid place-items-center">
                  <div class="absolute inset-0 grid-lines opacity-60" aria-hidden="true" />
                  <p class="display relative px-6 text-center text-[clamp(1.5rem,4vw,2.5rem)] text-subtle">
                    {title}
                  </p>
                </div>
              )
            }
          </div>
        </a>
      </div>
    </div>

    <!-- ── Detail ───────────────────────────────────────────────────── -->
    <div class:list={['lg:col-span-5', flip && 'lg:order-1']}>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
        <span class="font-mono text-2xs uppercase tracking-[0.12em] text-subtle">{kind}</span>
        <span class="text-line-strong" aria-hidden="true">·</span>
        <span class="font-mono text-2xs tracking-wide text-subtle">{period}</span>
        {
          (status === 'Live' || status === 'Ongoing') && (
            <span class="ml-auto flex shrink-0 items-center gap-1.5 font-mono text-2xs uppercase tracking-[0.1em] text-jade">
              <span class="relative flex size-1.5">
                <span class="absolute inline-flex size-full animate-ping rounded-full bg-jade opacity-60" />
                <span class="relative inline-flex size-1.5 rounded-full bg-jade" />
              </span>
              {status}
            </span>
          )
        }
      </div>

      <div class="mt-5 flex items-center gap-3.5">
        <!-- Logo tile, or the initial in the display face when there is none. -->
        <span
          class="grid size-11 shrink-0 place-items-center overflow-hidden rounded-lg border border-line bg-surface-2"
          aria-hidden="true"
        >
          {
            logo ? (
              <Image src={logo} alt="" width={88} height={88} class="size-full object-contain" />
            ) : (
              <span class="display text-lg leading-none text-subtle">{monogram}</span>
            )
          }
        </span>

        <h2
          class="display min-w-0 flex-1 text-[clamp(1.5rem,3vw,2.125rem)] leading-tight"
          style={`view-transition-name:project-${project.id}`}
        >
          <a href={detail} class="group/link">
            <span class="link">{title}</span>
            <Icon
              name="lucide:arrow-up-right"
              class="ml-0.5 inline-block size-[0.7em] -translate-y-px text-subtle transition-transform duration-300 group-hover/link:-translate-y-1 group-hover/link:translate-x-0.5 group-hover/link:text-accent"
              aria-hidden="true"
            />
          </a>
        </h2>
      </div>

      <p class="mt-4 leading-relaxed text-muted">{blurb}</p>

      <p class="mt-4 font-mono text-2xs uppercase tracking-[0.1em] text-subtle">{role}</p>

      {
        stats.length > 0 && (
          <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-md border border-line bg-line [&>*:last-child:nth-child(odd)]:col-span-2">
            {stats.map((s) => (
              <div class="bg-surface-2 px-3.5 py-3">
                <dt class="font-mono text-2xs uppercase tracking-[0.12em] text-subtle">
                  {s.label}
                </dt>
                <dd class="mt-1 text-[0.9375rem] leading-snug tracking-tight text-fg">{s.value}</dd>
              </div>
            ))}
          </dl>
        )
      }

      {
        stack.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Stack">
            {stack.slice(0, 6).map((s) => (
              <li class="chip">{s}</li>
            ))}
          </ul>
        )
      }

      {
        (demo || repo || repoPrivate) && (
          <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-line pt-5">
            {demo && (
              <a
                href={demo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 font-mono text-2xs uppercase tracking-[0.1em] text-muted transition-colors hover:text-accent"
              >
                <Icon name="lucide:external-link" class="size-3" aria-hidden="true" />
                Live
              </a>
            )}
            {repo && (
              <a
                href={repo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 font-mono text-2xs uppercase tracking-[0.1em] text-muted transition-colors hover:text-accent"
              >
                <Icon name="simple-icons:github" class="size-3" aria-hidden="true" />
                Source
              </a>
            )}
            {!repo && repoPrivate && (
              <span class="inline-flex items-center gap-1.5 font-mono text-2xs uppercase tracking-[0.1em] text-subtle">
                <Icon name="lucide:lock" class="size-3" aria-hidden="true" />
                Private source
              </span>
            )}
          </div>
        )
      }
    </div>
  </div>
</article>

<style>
  /* The lift is on the anchor rather than the whole row, so the text column
     stays put and only the frame moves. .card already carries the transition. */
  .card {
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card img {
      transition: none;
    }
    .card:hover,
    .group\/row:hover .card {
      transform: none;
    }
    .group\/row:hover img {
      transform: none;
    }
  }
</style>

<script>
  /* Points the glow at the cursor. Purely additive: the gradient already has
     a sensible default position, so with no JS, no pointer, or reduced motion
     the frame still lights up on hover — just centred. */
  /* Astro hoists and dedupes a processed script, so this runs once per page
     however many rows render — no guard needed. */
  (() => {
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)');

    function track(event: PointerEvent) {
      if (!fine.matches || calm.matches) return;
      const frame = (event.target as Element)?.closest?.('[data-frame]') as HTMLElement | null;
      if (!frame) return;
      const box = frame.getBoundingClientRect();
      frame.style.setProperty('--mx', `${((event.clientX - box.left) / box.width) * 100}%`);
      frame.style.setProperty('--my', `${((event.clientY - box.top) / box.height) * 100}%`);
    }

    // One delegated listener rather than two per frame, and passive so it
    // never blocks a scroll on a trackpad.
    document.addEventListener('pointermove', track, { passive: true });
  })();
</script>
