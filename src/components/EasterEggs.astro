---
/**
 * Three things for anyone who pokes around: a note in the source, a console
 * greeting, and the Konami code, which turns on the layout grid. All inert
 * until someone goes looking — no requests, nothing a normal visitor sees.
 */
---

<!--
     ____  __  __
    / ___||  \/  |
    \___ \| |\/| |
     ___) | |  | |
    |____/|_|  |_|

    No software engineering problem is too big to solve.

    You are reading the source. Good instinct.
    Try ⌘K for the command palette, or the Konami code for the layout grid.

    Built with Astro, deployed from GitHub Actions, no client framework.
    Say hi:  me@smr.et
-->
<div
  id="debug-badge"
  hidden
  class="fixed bottom-4 left-1/2 z-[9998] -translate-x-1/2 rounded-full border border-accent bg-surface px-4 py-2 meta text-accent shadow-lg"
  role="status"
>
  Layout grid on · Konami again to hide
</div>

<script>
  import { byId, dialogOpen, isEditable } from '@/lib/client/dom';

  const LABEL = 'color:#e9a23b;font-weight:600';
  const BODY = 'color:#96979d';
  const root = document.documentElement;

  console.log(
    `%cNo software engineering problem is too big to solve.%c
Built with Astro. No client framework, no analytics, no cookies.
Reach out:  ${root.dataset.email ?? ''}
Try ⌘K for the command palette. Or the Konami code.`,
    LABEL,
    BODY,
  );

  // ↑ ↑ ↓ ↓ ← → ← → B A
  const SEQUENCE = 'arrowup arrowup arrowdown arrowdown arrowleft arrowright arrowleft arrowright b a'.split(' ');
  /* KMP failure table: on a miss, fall back to the longest prefix that is
     still a suffix of what was typed, so ↑↑↑↓↓… still completes. */
  const FALLBACK = SEQUENCE.map(() => 0);
  for (let i = 1, k = 0; i < SEQUENCE.length; i++) {
    while (k > 0 && SEQUENCE[i] !== SEQUENCE[k]) k = FALLBACK[k - 1];
    if (SEQUENCE[i] === SEQUENCE[k]) k += 1;
    FALLBACK[i] = k;
  }
  let at = 0;
  let hideTimer = 0;

  document.addEventListener('keydown', (event) => {
    if (event.repeat || event.ctrlKey || event.metaKey || event.altKey || event.shiftKey) return;
    if (isEditable(event.target) || dialogOpen()) return;
    const key = event.key.toLowerCase();
    while (at > 0 && key !== SEQUENCE[at]) at = FALLBACK[at - 1];
    if (key === SEQUENCE[at]) at += 1;
    if (at < SEQUENCE.length) return;
    at = 0;
    const on = !root.hasAttribute('data-debug');
    root.toggleAttribute('data-debug', on);
    const badge = byId('debug-badge');
    if (badge) {
      badge.hidden = !on;
      clearTimeout(hideTimer);
      if (on) hideTimer = window.setTimeout(() => (badge.hidden = true), 4000);
    }
    console.log(
      `%cLayout grid ${on ? 'on' : 'off'}.%c Every box outlined, twelve columns behind the container.`,
      LABEL,
      BODY,
    );
  });
</script>
