---
import { site } from '@/lib/site';
import { href, isActive } from '@/lib/paths';
import { visibleNav } from '@/lib/posts';
import { Image } from 'astro:assets';
import avatar from '@/assets/avatar.jpg';
import ThemeToggle from './ThemeToggle.astro';
import { Icon } from 'astro-icon/components';

const current = Astro.url.pathname;

const items = await visibleNav();

// Rendered separately, beside the call to action.
const now = items.find((item) => item.href === '/now');
const nowActive = now ? isActive(current, href(now.href)) : false;
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-fg focus:px-4 focus:py-2 focus:text-sm focus:text-bg"
>
  Skip to content
</a>

<!-- Outside the header: its backdrop-filter would make it the containing
     block for a fixed child and stop the scrim covering the viewport. -->
<div id="menu-scrim" class="menu-scrim md:hidden" aria-hidden="true"></div>

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-line bg-bg/80 backdrop-blur-xl transition-shadow duration-300 data-[scrolled]:shadow-[0_1px_0_0_var(--color-line)]"
>
  <div class="header-bar wrap flex h-16 items-center justify-between gap-4">
    <!-- Wordmark -->
    <a
      href={href('/')}
      class="group flex items-center gap-2.5 -ml-1 rounded-full px-1 py-1"
      aria-label={`${site.name} — home`}
    >
      <Image
        src={avatar}
        alt=""
        width={72}
        height={72}
        loading="eager"
        class="wordmark-avatar size-8 shrink-0 rounded-full object-cover ring-1 ring-line-strong group-hover:ring-accent"
      />
      <span class="flex flex-col leading-none">
        <span class="display text-[1.2rem] tracking-tight">{site.name}</span>
        <span class="wordmark-sub hidden whitespace-nowrap font-mono text-2xs tracking-wider text-subtle lg:block"
          >{site.role} · {site.locationShort}</span
        >
      </span>
    </a>

    <!-- Desktop nav -->
    <nav id="primary-nav" aria-label="Primary" class="nav-rail relative hidden items-center gap-0.5 md:flex">
      <span class="nav-indicator" aria-hidden="true"></span>
      {
        items
          .slice(1)
          .filter((item) => item.href !== '/now')
          .map((item) => {
            const active = isActive(current, href(item.href));
            return (
              <a
                href={href(item.href)}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'nav-link relative rounded-full px-3.5 py-2 text-sm transition-colors duration-200',
                  active ? 'text-fg' : 'text-muted hover:text-fg',
                ]}
              >
                {item.label}
                {active && (
                  <span class="nav-link-hairline absolute inset-x-3.5 -bottom-px h-px bg-accent" aria-hidden="true" />
                )}
              </a>
            );
          })
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="cmdk-open"
        class="hidden h-9 items-center gap-2 rounded-full border border-line pl-3 pr-2 text-subtle transition-colors hover:border-line-strong hover:text-fg md:inline-flex"
        aria-label="Search and jump to a page"
      >
        <Icon name="lucide:search" class="size-3.5" aria-hidden="true" />
        <kbd class="rounded border border-line bg-surface-2 px-1.5 py-0.5 font-mono text-2xs"> ⌘K </kbd>
      </button>
      {
        now && (
          <a
            href={href(now.href)}
            aria-current={nowActive ? 'page' : undefined}
            title="What I have pushed and watched lately"
            class:list={[
              'meta inline-flex h-9 items-center gap-2 rounded-full border pl-2.5 pr-3 transition-colors',
              nowActive ? 'border-jade/60 text-fg' : 'border-line text-subtle hover:border-line-strong hover:text-fg',
            ]}
          >
            <span class="relative flex size-1.5" aria-hidden="true">
              <span class="absolute inline-flex size-full animate-ping rounded-full bg-jade opacity-70" />
              <span class="relative inline-flex size-1.5 rounded-full bg-jade" />
            </span>
            {now.label}
          </a>
        )
      }
      <ThemeToggle />
      <a
        href={href('/contact')}
        class="btn btn-primary hidden whitespace-nowrap !px-4 !py-2 !text-[0.8125rem] lg:inline-flex"
      >
        Get in touch
      </a>

      <!-- Mobile menu trigger -->
      <button
        type="button"
        id="menu-toggle"
        class="grid size-9 place-items-center rounded-full border border-line text-muted transition-colors hover:border-line-strong hover:text-fg md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          class="size-[17px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path class="menu-bar-top" d="M4 8h16"></path>
          <path class="menu-bar-bottom" d="M4 16h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" hidden class="menu-panel md:hidden">
    <nav aria-label="Mobile" class="menu-panel-inner wrap flex flex-col py-2">
      {
        items.map((item, i) => {
          const active = isActive(current, href(item.href));
          return (
            <a
              href={href(item.href)}
              aria-current={active ? 'page' : undefined}
              style={`--i:${i}`}
              class:list={[
                'menu-row flex items-baseline gap-3 border-b border-line py-3.5 text-lg tracking-tight transition-colors last:border-b-0',
                active ? 'text-accent' : 'text-fg',
              ]}
            >
              <span class="font-mono text-2xs text-subtle">{item.index}</span>
              {item.label}
            </a>
          );
        })
      }
      <a href={`mailto:${site.email}`} style={`--i:${items.length}`} class="menu-row btn btn-primary my-4 w-full"
        >{site.email}</a
      >
    </nav>
  </div>

  <!-- Reading progress: the hairline on the header's own bottom edge grows
       with the document. Scroll-driven, so it costs no script. -->
  <div class="scroll-progress" aria-hidden="true"></div>
</header>

<style>
  /* ── Compression: inside a height the bar never changes. See "Motion". */
  .wordmark-avatar {
    transition:
      box-shadow var(--t-2) var(--ease-out-quint),
      scale var(--t-3) var(--ease-out-quint);
  }
  #site-header[data-scrolled] .wordmark-avatar {
    scale: 0.86;
  }
  /* max-height rather than display, so it animates. */
  .wordmark-sub {
    margin-top: 0.25rem;
    max-height: 1.5em;
    overflow: hidden;
    transition:
      max-height var(--t-3) var(--ease-out-quint),
      margin-top var(--t-3) var(--ease-out-quint),
      opacity var(--t-2) var(--ease-out-quint);
  }
  #site-header[data-scrolled] .wordmark-sub {
    max-height: 0;
    margin-top: 0;
    opacity: 0;
  }

  .menu-bar-top,
  .menu-bar-bottom {
    transition: transform var(--t-2) var(--ease-out-quint);
    transform-origin: center;
  }
  #menu-toggle[aria-expanded='true'] .menu-bar-top {
    transform: translateY(4px) rotate(45deg);
  }
  #menu-toggle[aria-expanded='true'] .menu-bar-bottom {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* ── Reading progress. Longhands, never the shorthand: the minifier folds
     animation-timeline in and Chromium then drops the declaration. */
  .scroll-progress {
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    height: 2px;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left center;
  }
  @supports (animation-timeline: scroll()) {
    .scroll-progress {
      animation-name: progress;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root block);
    }
  }
  @keyframes progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  /* The panel's top border lands on the same edge; the hairline steps aside. */
  #site-header:has(.menu-panel.is-open) .scroll-progress {
    opacity: 0;
  }
  .scroll-progress {
    transition: opacity var(--t-1) var(--ease-out-quint);
  }

  /* ── Nav indicator. One hairline slides between the links; until the script
     measures them the per-link rules hold. */
  .nav-indicator {
    position: absolute;
    bottom: -1px;
    left: 0;
    height: 1px;
    /* Scaled, not width-animated: width is a layout property. */
    width: 1px;
    transform-origin: left center;
    scale: var(--w, 0) 1;
    background-color: var(--color-accent);
    translate: var(--x, 0px) 0;
    opacity: 0;
    pointer-events: none;
    transition:
      translate var(--t-3) var(--ease-out-quint),
      scale var(--t-3) var(--ease-out-quint),
      opacity var(--t-1) var(--ease-out-quint);
  }
  .nav-rail[data-indicator] .nav-indicator {
    opacity: 1;
  }
  /* With the indicator live, the per-link hairlines would double it. */
  .nav-rail[data-indicator] .nav-link::after {
    display: none;
  }
  .nav-rail[data-indicator] .nav-link-hairline {
    display: none;
  }

  /* ── Mobile menu. One grid row growing 0fr → 1fr, so it opens to its
     content's height with no magic number; display:grid beats [hidden], hence
     the rule below. Absolute, so opening it never pushes the page. */
  .menu-panel {
    position: absolute;
    top: 100%;
    inset-inline: 0;
    display: grid;
    grid-template-rows: 0fr;
    border-top: 1px solid var(--color-line);
    background-color: var(--color-bg);
    transition: grid-template-rows var(--t-3) var(--ease-out-quint);
  }
  .menu-panel[hidden] {
    display: none;
  }
  .menu-panel.is-open {
    grid-template-rows: 1fr;
  }
  .menu-panel-inner {
    overflow: hidden;
    min-height: 0;
  }

  /* Rows arrive one after another once the panel is on its way open. */
  .menu-panel.is-open .menu-row {
    animation: menu-row-in var(--t-3) var(--ease-out-quint) both;
    animation-delay: calc(70ms + var(--i, 0) * 38ms);
  }
  @keyframes menu-row-in {
    from {
      opacity: 0;
      transform: translate3d(-12px, 0, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* The scrim veils the page under the panel and closes it on a tap. */
  .menu-scrim {
    position: fixed;
    inset: 0;
    z-index: 40;
    background-color: rgb(var(--c-bg) / 0.6);
    backdrop-filter: blur(6px);
    opacity: 0;
    pointer-events: none;
    touch-action: none;
    overscroll-behavior: contain;
    transition: opacity var(--t-3) var(--ease-out-quint);
  }
  .menu-scrim.is-open {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  import { mobileMenu, navIndicator } from '@/lib/client/header';

  mobileMenu();
  navIndicator();
</script>
