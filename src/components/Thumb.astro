---
/**
 * Album art or a poster, hotlinked, over a placeholder that shows while it
 * loads, when there is none, and when the host refuses it.
 */
interface Props {
  src: string | null;
  width: number;
  height: number;
  class: string;
}
const { src, width, height, class: cls } = Astro.props as Props;
const box = `${cls} shrink-0 rounded border border-line`;
---

{
  src ? (
    <span class:list={[box, 'block overflow-hidden bg-surface-2']} aria-hidden="true">
      {/* A hotlink can vanish; a broken-image icon is worse than the plain box. */}
      <img
        {src}
        alt=""
        {width}
        {height}
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        onerror="this.remove()"
        class="size-full object-cover"
      />
    </span>
  ) : (
    <span class:list={[box, 'bg-surface-2']} aria-hidden="true" />
  )
}
