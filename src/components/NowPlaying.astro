---
/**
 * Live "currently listening" card, filled in the browser from
 * /api/now-playing — a Cloudflare Worker on this same domain, so the fetch is
 * same-origin and the Spotify credentials stay server-side. See worker/.
 *
 * Shows one of three things, whichever the Worker could establish: the track
 * playing now, with a live progress bar; a paused track, frozen where it
 * stopped; or the last one that finished, with how long ago. Only a Worker
 * that cannot name any track at all leaves the card hidden — before it is
 * deployed, or when Spotify is unreachable.
 *
 * public/api/now-playing.json answers { playing: false } so the fetch is a 200
 * even with no Worker deployed. A caught exception still leaves the browser
 * logging a failed request to the console, and an endpoint that does not exist
 * yet is not something a visitor should see an error about. In production the
 * Worker route shadows that file and the static copy is never reached.
 */
import { Icon } from 'astro-icon/components';
import { href } from '@/lib/paths';

/**
 * Where to read the payload from. Defaults to a same-origin path, which is the
 * better arrangement: the Worker sits on a smr.et/api/* route in front of the
 * static origin, so there is no extra DNS lookup, no TLS handshake to a second
 * host, and no CORS preflight to fail.
 *
 * Set PUBLIC_NOW_PLAYING_URL to an absolute URL if the Worker is instead on its
 * own hostname (a Cloudflare custom domain such as now-playing.smr.et). That
 * works too — the Worker sends Access-Control-Allow-Origin — it is just one
 * more hop and one more thing a blocker can catch. Being a PUBLIC_ variable it
 * is inlined into the page, which is correct: it is a URL, not a secret.
 */
const endpoint = import.meta.env.PUBLIC_NOW_PLAYING_URL || href('/api/now-playing.json');
---

<section id="now-playing" hidden class="scroll-mt-24">
  <div class="wrap py-10 lg:py-16">
    <a
      id="np-link"
      href="https://open.spotify.com/"
      target="_blank"
      rel="noopener noreferrer"
      class="group relative block overflow-hidden rounded-xl border border-line bg-surface p-5 transition-colors hover:border-line-strong sm:p-7"
    >
      <!-- Warmth behind the sleeve, so the card is not a flat rectangle. -->
      <div
        class="pointer-events-none absolute -right-16 -top-16 size-64 rounded-full opacity-0 blur-3xl transition-opacity duration-700 group-hover:opacity-100"
        style="background:radial-gradient(circle,rgb(var(--c-accent)/0.35),transparent 70%)"
        aria-hidden="true"
      >
      </div>

      <div class="relative flex items-center gap-5 sm:gap-7">
        <div class="min-w-0 flex-1">
          <p
            class="flex items-center gap-2.5 whitespace-nowrap font-mono text-2xs uppercase tracking-[0.1em] text-subtle sm:tracking-[0.14em]"
          >
            <span id="np-eq" class="eq" aria-hidden="true">
              <span></span><span></span><span></span><span></span>
            </span>
            <span id="np-state">Currently listening</span>
          </p>

          <p
            id="np-title"
            class="display mt-4 text-[clamp(1.5rem,3.6vw,2.35rem)] leading-tight text-fg"
          >
          </p>
          <p id="np-artist" class="mt-2 text-[0.9375rem] text-muted sm:text-base"></p>

          <!-- Stays hidden unless the track reports a duration. Podcast
               episodes and local files do not always, and a bar with no end
               is worse than no bar. -->
          <div id="np-progress" class="mt-5 max-w-md" hidden>
            <div class="h-[3px] overflow-hidden rounded-full bg-line" aria-hidden="true">
              <!-- Width is set from JS every second; the matching linear
                   transition turns those steps into continuous movement. -->
              <div
                id="np-bar"
                class="h-full rounded-full bg-jade transition-[width] duration-1000 ease-linear motion-reduce:transition-none"
                style="width:0%"
              >
              </div>
            </div>
            <!-- The times, not the bar, carry this to a screen reader: the bar
                 is decoration, and a progressbar role rewritten every second
                 is chatter. -->
            <p class="mt-2 flex justify-between font-mono text-2xs tabular-nums text-subtle">
              <span id="np-elapsed">0:00</span>
              <span id="np-duration">0:00</span>
            </p>
          </div>

          <p
            class="mt-4 flex items-center gap-2 font-mono text-2xs uppercase tracking-[0.1em] text-subtle"
          >
            <Icon name="simple-icons:spotify" class="size-3.5 text-jade" aria-hidden="true" />
            Spotify
          </p>
        </div>

        <!-- Fixed box so the card does not reflow when the art loads. -->
        <div
          class="relative aspect-square w-24 shrink-0 overflow-hidden rounded-lg border border-line bg-surface-2 sm:w-32 lg:w-40"
        >
          <img
            id="np-art"
            alt=""
            width="320"
            height="320"
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
            class="size-full object-cover opacity-0 transition-opacity duration-500"
          />
        </div>
      </div>
    </a>
  </div>
  <div class="rule"></div>
</section>

<style>
  /* Four bars, each on its own duration as well as its own offset, so it
     reads as a level meter rather than four things blinking in step.

     Sized in rem rather than em on purpose: the label around it is 11px, and
     at 0.85em the bars came out 9px tall and 2px wide, animating over about
     six pixels. Technically moving, practically invisible. */
  .eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 2.5px;
    height: 0.9rem;
  }
  .eq > span {
    width: 2.5px;
    height: 100%;
    border-radius: 1px;
    background-color: var(--color-jade);
    transform-origin: bottom;
    animation: eq 1.1s ease-in-out infinite;
    /* Without this the bar is scaled to a sub-pixel height at the bottom of
       its cycle and some renderers drop it entirely, which reads as a gap. */
    will-change: transform;
  }
  /* --h is the height each bar freezes at. Declared alongside its timing so
     the two ways of stopping the meter — paused, and a visitor who asked for
     less motion — share one set of numbers instead of drifting apart. */
  .eq > span:nth-child(1) {
    --h: 45%;
    animation-duration: 1.05s;
    animation-delay: -0.9s;
  }
  .eq > span:nth-child(2) {
    --h: 100%;
    animation-duration: 0.8s;
    animation-delay: -0.45s;
  }
  .eq > span:nth-child(3) {
    --h: 65%;
    animation-duration: 1.3s;
    animation-delay: -0.7s;
  }
  .eq > span:nth-child(4) {
    --h: 85%;
    animation-duration: 0.95s;
    animation-delay: -0.2s;
  }
  @keyframes eq {
    0%,
    100% {
      transform: scaleY(0.2);
    }
    50% {
      transform: scaleY(1);
    }
  }

  /* Stopped: nothing is playing, or the visitor asked for less motion. Static
     bars at four different heights still read as a level meter — a stopped
     one. A meter dancing above the word "Paused" would just be a lie. */
  .eq.is-still > span {
    animation: none;
    height: var(--h);
  }
  @media (prefers-reduced-motion: reduce) {
    .eq > span {
      animation: none;
      height: var(--h);
    }
  }
</style>

<script is:inline define:vars={{ endpoint }}>
  (() => {
    // Re-runs on navigation; the poll is registered once per document.
    if (window.__np) return;
    window.__np = true;

    /* Poll interval while the tab is visible. The edge caches for a few
       seconds, so polling faster than this mostly re-reads the same answer;
       polling slower is what made the card feel dead. Between the two, a
       state change shows up in about ten seconds without a refresh. */
    const REFRESH_MS = 15000;
    /* Ceiling on the staleness correction below. The edge now holds a response
       for only a few seconds, so in practice the correction is tiny — this is
       a bound on how far a badly set clock can shove the bar, not a tuning
       knob, and it stays generous so that raising the Worker's TTL again does
       not silently start clipping a legitimate correction. */
    const MAX_AGE_MS = 60000;

    /* Where the bar is, and when that was true. Progress is derived from these
       rather than stored, so a missed tick self-corrects on the next one. */
    let base = 0;
    let baseAt = 0;
    let total = 0;
    let ticker = 0;
    let lastTitle = '';

    /** 3:07, or 1:02:44 for a long podcast episode. */
    function clock(ms) {
      const t = Math.max(0, Math.round(ms / 1000));
      const pad = (n) => String(n).padStart(2, '0');
      const h = Math.floor(t / 3600);
      const m = Math.floor((t % 3600) / 60);
      return h > 0 ? `${h}:${pad(m)}:${pad(t % 60)}` : `${m}:${pad(t % 60)}`;
    }

    /** "12 min ago". Coarse, so a cached answer cannot look precise. */
    function since(iso) {
      const ms = Date.now() - new Date(iso).getTime();
      if (!Number.isFinite(ms) || ms < 0) return '';
      const min = Math.floor(ms / 60000);
      if (min < 1) return 'just now';
      if (min < 60) return `${min} min ago`;
      const hours = Math.floor(min / 60);
      if (hours < 24) return `${hours} ${hours === 1 ? 'hour' : 'hours'} ago`;
      const days = Math.floor(hours / 24);
      return days === 1 ? 'yesterday' : `${days} days ago`;
    }

    function renderProgress() {
      const bar = document.getElementById('np-bar');
      const elapsed = document.getElementById('np-elapsed');
      if (!total || !bar || !elapsed) return;

      const ms = Math.min(base + (Date.now() - baseAt), total);
      bar.style.width = `${((ms / total) * 100).toFixed(2)}%`;
      elapsed.textContent = clock(ms);

      // Ran off the end. The track is over and the next poll knows what
      // replaced it; carrying on would only be wrong faster.
      if (ms >= total) stopTicker();
    }

    function startTicker() {
      window.clearInterval(ticker);
      ticker = window.setInterval(() => {
        if (!document.hidden) renderProgress();
      }, 1000);
    }

    function stopTicker() {
      window.clearInterval(ticker);
      ticker = 0;
    }

    async function poll() {
      const section = document.getElementById('now-playing');
      if (!section) return;

      let data = null;
      try {
        // cache: 'no-store' bypasses the browser's HTTP cache. Necessary
        // because Cloudflare's zone-level Browser Cache TTL rewrites the
        // Worker's max-age to its own default — 4 hours on this zone — so
        // without this every poll would re-read a stale copy and the card
        // would pin one track for the afternoon. The edge cache still
        // shields Spotify: s-maxage survives the rewrite.
        const res = await fetch(endpoint, {
          headers: { Accept: 'application/json' },
          cache: 'no-store',
        });
        if (res.ok) data = await res.json();
      } catch {
        // Offline, blocked, or DNS still catching up. Leave the card hidden.
      }

      // A title is the only requirement. Paused counts, and so does the last
      // thing that finished — the card is about what he is listening to, not
      // about whether a play button happens to be down right now.
      if (!data || !data.title) {
        section.hidden = true;
        total = 0;
        stopTicker();
        return;
      }

      /* An older deployed Worker sends no state, so infer it. Without this the
         card would read "Paused" over a playing track for as long as the two
         are out of step. */
      const state = data.state || (data.playing ? 'playing' : 'paused');
      const live = state === 'playing';

      const title = document.getElementById('np-title');
      const artist = document.getElementById('np-artist');
      const art = document.getElementById('np-art');
      const link = document.getElementById('np-link');

      title.textContent = data.title;
      artist.textContent = data.artist || '';
      if (data.url) link.href = data.url;

      const eq = document.getElementById('np-eq');
      if (eq) eq.classList.toggle('is-still', !live);

      const stateEl = document.getElementById('np-state');
      if (stateEl) {
        // "Last played" says when, because a track that finished four hours
        // ago and one that finished a minute ago are different facts.
        const when = state === 'recent' && data.playedAt ? since(data.playedAt) : '';
        stateEl.textContent =
          state === 'playing'
            ? 'Currently listening'
            : state === 'paused'
              ? 'Paused'
              : when
                ? `Last played · ${when}`
                : 'Last played';
      }

      if (data.art) {
        // Only fade the sleeve in once it has actually decoded.
        if (art.src !== data.art) {
          art.style.opacity = '0';
          art.src = data.art;
          art.alt = data.album ? `${data.album} — album art` : '';
          art.onload = () => (art.style.opacity = '1');
        }
      } else {
        art.removeAttribute('src');
        art.style.opacity = '0';
      }

      /* The bar advances locally between polls. Left to the poll alone it
         would sit still for 45 seconds at a time — a quarter of a short
         track — and then jump. */
      const bar = document.getElementById('np-bar');
      const progress = document.getElementById('np-progress');
      const duration = Number(data.durationMs);
      const at = Number(data.progressMs);

      // A finished track has no position, so there is no bar to draw for it.
      // A paused one does, and showing it frozen is the point.
      if (
        bar &&
        progress &&
        state !== 'recent' &&
        Number.isFinite(duration) &&
        duration > 0 &&
        Number.isFinite(at)
      ) {
        /* Add back however long the reading sat in the edge cache, so the bar
           starts where the track actually is. Clamped because this subtracts
           the edge's clock from the visitor's: a badly set clock would
           otherwise peg the bar to one end. Losing the correction only costs
           the few seconds it was worth. */
        const stamp = Number(data.fetchedAt);
        const age =
          live && Number.isFinite(stamp)
            ? Math.min(Math.max(Date.now() - stamp, 0), MAX_AGE_MS)
            : 0;

        // A new track must not glide backwards out of the old one's position.
        if (data.title !== lastTitle) {
          bar.style.transition = 'none';
          requestAnimationFrame(() => (bar.style.transition = ''));
        }

        base = Math.min(at + age, duration);
        baseAt = Date.now();
        total = duration;
        document.getElementById('np-duration').textContent = clock(duration);
        progress.hidden = false;
        renderProgress();
        // A paused bar is rendered once and then left alone. Ticking it would
        // advance a track that is not moving.
        if (live) startTicker();
        else stopTicker();
      } else if (progress) {
        total = 0;
        progress.hidden = true;
        stopTicker();
      }
      lastTitle = data.title;

      section.hidden = false;
    }

    function start() {
      poll();
      window.clearInterval(window.__npTimer);
      // Only poll while the tab is visible — a background tab has no reason to.
      window.__npTimer = window.setInterval(() => {
        if (!document.hidden) poll();
      }, REFRESH_MS);
    }

    /* Both, because they do not fire interchangeably: switching tabs gives
       visibilitychange, while returning to an already-visible window from
       another application gives only focus. Coming back to the page is the
       moment a stale card is most obvious, so neither is worth missing. */
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) poll();
    });
    window.addEventListener('focus', () => {
      if (!document.hidden) poll();
    });

    start();
    document.addEventListener('astro:page-load', poll);
  })();
</script>
