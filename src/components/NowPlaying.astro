---
/**
 * Live "currently listening" card, filled in the browser from the Worker in
 * worker/. Playing with a live bar, paused where it stopped, or the last track
 * that finished; no track at all leaves the card hidden. It holds its shape as
 * a skeleton, shown before the first paint, until the first answer — why that
 * costs no layout shift is in docs/architecture.md, "Now playing".
 */
import { Icon } from 'astro-icon/components';
import { href } from '@/lib/paths';

/** Same-origin by default; PUBLIC_NOW_PLAYING_URL puts it on its own host. */
const endpoint = import.meta.env.PUBLIC_NOW_PLAYING_URL || href('/api/now-playing.json');
---

<section id="now-playing" hidden data-state="loading" data-endpoint={endpoint} aria-busy="true" class="scroll-mt-24">
  <div class="wrap py-10 lg:py-16">
    <a
      id="np-link"
      href="https://open.spotify.com/"
      target="_blank"
      rel="noopener noreferrer"
      aria-hidden="true"
      tabindex="-1"
      class="group relative block overflow-hidden rounded-xl border border-line bg-surface p-5 transition-colors hover:border-line-strong sm:p-7"
    >
      <!-- Warmth behind the sleeve, so the card is not a flat rectangle. -->
      <div
        class="pointer-events-none absolute -right-16 -top-16 size-64 rounded-full opacity-0 blur-3xl transition-opacity duration-700 group-hover:opacity-100"
        style="background:radial-gradient(circle,rgb(var(--c-accent)/0.35),transparent 70%)"
        aria-hidden="true"
      >
      </div>

      <div class="relative flex items-center gap-5 sm:gap-7">
        <div class="min-w-0 flex-1">
          <p class="flex items-center gap-2.5 whitespace-nowrap meta sm:tracking-[0.14em]">
            <span id="np-eq" class="eq" aria-hidden="true">
              <span></span><span></span><span></span><span></span>
            </span>
            <span id="np-state"><span class="sk sk-state"></span></span>
          </p>

          <p id="np-title" class="display mt-4 text-[clamp(1.5rem,3.6vw,2.35rem)] leading-tight text-fg">
            <span class="sk sk-title"></span>
          </p>
          <p id="np-artist" class="mt-2 text-[0.9375rem] text-muted sm:text-base">
            <span class="sk sk-artist"></span>
          </p>

          <!-- Starts shown and empty so the skeleton reserves the row; the
               script hides it when the track reports no duration. -->
          <div id="np-progress" class="mt-5 max-w-md">
            <div class="h-[3px] overflow-hidden rounded-full bg-line" aria-hidden="true">
              <!-- Width set each second; the linear transition smooths the steps. -->
              <div
                id="np-bar"
                class="h-full rounded-full bg-jade transition-[width] duration-1000 ease-linear motion-reduce:transition-none"
                style="width:0%"
              >
              </div>
            </div>
            <!-- The times carry this to a screen reader; the bar is decoration. -->
            <p class="mt-2 flex justify-between font-mono text-2xs tabular-nums text-subtle">
              <span id="np-elapsed"><span class="sk sk-time"></span></span>
              <span id="np-duration"><span class="sk sk-time"></span></span>
            </p>
          </div>

          <p class="mt-4 flex items-center gap-2 meta">
            <Icon name="simple-icons:spotify" class="size-3.5 text-jade" aria-hidden="true" />
            Spotify
          </p>
        </div>

        <!-- Fixed box so the card does not reflow when the art loads. -->
        <div
          id="np-sleeve"
          data-art="pending"
          class="relative aspect-square w-24 shrink-0 overflow-hidden rounded-lg border border-line bg-surface-2 sm:w-32 lg:w-40"
        >
          <!-- Behind the art, which fades in over it once loaded. -->
          <div class="sk sk-art" aria-hidden="true"></div>
          <img
            id="np-art"
            alt=""
            width="320"
            height="320"
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
            class="size-full object-cover opacity-0 transition-opacity duration-500"
          />
        </div>
      </div>
    </a>
  </div>
  <div class="rule"></div>
</section>

<!-- Before the first paint, so the skeleton is already holding the card's
     space when the answer lands and the swap moves nothing. Without script the
     card stays hidden; after an empty answer the next visit does not reserve
     a card that is likely to collapse again. The key is EMPTY_KEY in
     now-playing.ts. -->
<script is:inline>
  (() => {
    const card = document.getElementById('now-playing');
    let empty = false;
    try {
      empty = localStorage.getItem('np-empty') === '1';
    } catch {
      /* storage blocked — reserve the card */
    }
    if (card && !empty) card.hidden = false;
  })();
</script>

<style>
  /* Sized in `em` and under 1em tall, so the line box is unchanged and the
     element measures what it will with one line of text in it. The pulse rests
     at full opacity, so reduced motion leaves a plain bar. */
  .sk {
    display: inline-block;
    vertical-align: middle;
    height: 0.62em;
    border-radius: 999px;
    background-color: var(--color-line);
    animation: sk-pulse 1.7s ease-in-out infinite;
  }
  @keyframes sk-pulse {
    50% {
      opacity: 0.45;
    }
    0%,
    100% {
      opacity: 1;
    }
  }
  .sk-state {
    width: 8.5rem;
  }
  .sk-title {
    width: 72%;
  }
  .sk-artist {
    width: 38%;
  }
  .sk-time {
    width: 2.25rem;
  }
  /* The sleeve, filling its box rather than sitting on a text line. */
  .sk-art {
    position: absolute;
    inset: 0;
    height: auto;
    border-radius: 0;
    animation-delay: 0.2s;
  }

  /* Offsets so the bars breathe out of step, the way the meter does. */
  .sk-title {
    animation-delay: 0.08s;
  }
  .sk-artist {
    animation-delay: 0.16s;
  }

  /* The one placeholder that cannot clear itself: it waits for the image
     rather than the state, and stops pulsing as soon as there is an answer. */
  #np-sleeve[data-art='ready'] .sk-art,
  #np-sleeve[data-art='none'] .sk-art {
    opacity: 0;
  }
  .sk-art {
    transition: opacity var(--t-3) ease;
  }
  #now-playing:not([data-state='loading']) .sk-art {
    animation: none;
  }
  /* A meter has nothing to report until there is a track, and the card is
     not a link to anywhere until it names one. */
  #now-playing[data-state='loading'] .eq {
    display: none;
  }
  #now-playing[data-state='loading'] #np-link {
    pointer-events: none;
  }

  /* Four bars on four durations, so it reads as a level meter rather than
     four things blinking in step. rem, not em: at 0.85em of an 11px label the
     bars animated over six pixels — technically moving, practically not. */
  .eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 2.5px;
    height: 0.9rem;
  }
  .eq > span {
    width: 2.5px;
    height: 100%;
    border-radius: 1px;
    background-color: var(--color-jade);
    transform-origin: bottom;
    animation: eq 1.1s ease-in-out infinite;
    /* Without this the bar is scaled to a sub-pixel height at the bottom of
       its cycle and some renderers drop it entirely, which reads as a gap. */
    will-change: transform;
  }
  /* --h is where each bar freezes, shared by both ways of stopping the meter. */
  .eq > span:nth-child(1) {
    --h: 45%;
    animation-duration: 1.05s;
    animation-delay: -0.9s;
  }
  .eq > span:nth-child(2) {
    --h: 100%;
    animation-duration: 0.8s;
    animation-delay: -0.45s;
  }
  .eq > span:nth-child(3) {
    --h: 65%;
    animation-duration: 1.3s;
    animation-delay: -0.7s;
  }
  .eq > span:nth-child(4) {
    --h: 85%;
    animation-duration: 0.95s;
    animation-delay: -0.2s;
  }
  @keyframes eq {
    0%,
    100% {
      transform: scaleY(0.2);
    }
    50% {
      transform: scaleY(1);
    }
  }

  /* Stopped, but still four heights: a meter dancing over "Paused" is a lie. */
  .eq.is-still > span {
    animation: none;
    height: var(--h);
  }
  @media (prefers-reduced-motion: reduce) {
    .eq > span {
      animation: none;
      height: var(--h);
    }
  }
</style>

<script>
  import { nowPlaying } from '@/lib/client/now-playing';

  nowPlaying();
</script>
