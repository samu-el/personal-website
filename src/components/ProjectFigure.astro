---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import PreviewFrame from '@/components/PreviewFrame.astro';
import { href } from '@/lib/paths';

/** A framed screenshot captioned by its title alone, as the home page shows it.
 *  Kind and status are on the project's own page. */
interface Props {
  project: CollectionEntry<'projects'>;
  delay?: number;
  eager?: boolean;
  captionClass?: string;
  /** On the figure: its grid placement. */
  class?: string;
  /** On the frame: a phone's width where it shares a row. */
  frameClass?: string;
}
const { project, delay = 0, eager = false, captionClass = '', class: className, frameClass } = Astro.props as Props;
const d = project.data;
---

<figure class={className} data-reveal style={`--reveal-delay:${delay}ms`}>
  <PreviewFrame {project} {eager} class={frameClass} />
  <figcaption class:list={['mt-4', captionClass]}>
    <h3 class="display text-[1.5rem]" style={`view-transition-name:project-${project.id}`}>
      <a href={href(`/work/${project.id}`)} class="group/link">
        <span class="link">{d.title}</span>
        <Icon
          name="lucide:arrow-right"
          class="ml-0.5 inline-block size-[0.7em] -translate-y-px text-subtle transition-transform duration-300 group-hover/link:translate-x-1 group-hover/link:text-accent"
          aria-hidden="true"
        />
      </a>
    </h3>
  </figcaption>
</figure>
