---
import type { CollectionEntry } from 'astro:content';
import PreviewFrame from '@/components/PreviewFrame.astro';
import { href } from '@/lib/paths';

/** A screenshot captioned by its title alone, as the home page shows it.
 *  Kind and status are on the project's own page. */
interface Props {
  project: CollectionEntry<'projects'>;
  delay?: number;
  eager?: boolean;
  sizes?: string;
  aspect?: string;
  captionClass?: string;
  class?: string;
}
const {
  project,
  delay = 0,
  eager = false,
  sizes,
  aspect,
  captionClass = '',
  class: className = '',
} = Astro.props as Props;
const d = project.data;
---

<figure data-reveal style={`--reveal-delay:${delay}ms`} class={className}>
  <PreviewFrame {project} {eager} {sizes} {aspect} />
  <figcaption class:list={['mt-5', captionClass]}>
    <h3 class="display text-title" style={`view-transition-name:project-${project.id}`}>
      <a href={href(`/work/${project.id}`)} class="link">{d.title}</a>
    </h3>
  </figcaption>
</figure>
