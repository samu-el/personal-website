---
/**
 * A titled block on a long page: a display heading with the index behind it
 * as a watermark. The same shape as PageHeader, one level down. No eyebrow,
 * no lede: the heading names the block and the content explains it.
 */
interface Props {
  /** Two-digit watermark, e.g. "03". Decoration only. */
  index?: string;
  title?: string;
  id?: string;
  /** Renders the top hairline rule. */
  divider?: boolean;
  class?: string;
}

const { index, title, id, divider = true, class: className = '' } = Astro.props;
const hasHeader = Boolean(title);
---

<section id={id} class:list={['scroll-mt-24', className]}>
  {divider && <div class="rule-heavy" data-draw />}
  <div class="wrap relative py-12 lg:py-28">
    {
      hasHeader && (
        <header class="relative">
          {index && (
            <span class="rail-index" aria-hidden="true">
              {index}
            </span>
          )}
          <h2 class="display relative text-[clamp(2.1rem,5.4vw,3.6rem)]" data-reveal>
            {title}
          </h2>
        </header>
      )
    }
    <div class:list={['relative', hasHeader && 'mt-10 lg:mt-20']}>
      <slot />
    </div>
  </div>
</section>
