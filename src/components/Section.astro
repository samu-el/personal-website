---
/**
 * A titled block on a long page: index eyebrow, display heading, optional
 * lede in the right column, and the index repeated as a watermark. The same
 * shape as PageHeader, one level down.
 */
interface Props {
  /** Monospace index shown in the eyebrow and as the watermark, e.g. "03". */
  index?: string;
  eyebrow?: string;
  title?: string;
  lede?: string;
  id?: string;
  /** Renders the top hairline rule. */
  divider?: boolean;
  class?: string;
}

const { index, eyebrow, title, lede, id, divider = true, class: className = '' } = Astro.props;
const hasHeader = Boolean(eyebrow || title || lede);
---

<section id={id} class:list={['scroll-mt-24', className]}>
  {divider && <div class="rule" />}
  <div class="wrap relative py-12 lg:py-28">
    {
      hasHeader && (
        <header class="relative">
          {index && (
            <span class="rail-index" aria-hidden="true">
              {index}
            </span>
          )}
          <div class="relative grid gap-6 lg:grid-cols-12 lg:gap-8">
            <div class="lg:col-span-6">
              {eyebrow && (
                <p class="eyebrow" data-reveal>
                  {index && <span class="text-accent">{index}</span>}
                  {eyebrow}
                </p>
              )}
              {title && (
                <h2
                  class="display mt-5 text-[clamp(2.1rem,5.4vw,3.6rem)]"
                  data-reveal
                  style="--reveal-delay:60ms"
                >
                  {title}
                </h2>
              )}
            </div>
            {lede && (
              <div class="lg:col-span-5 lg:col-start-8 lg:self-end">
                <p
                  class="max-w-xl border-l border-line pl-5 text-base leading-relaxed text-muted lg:text-[1.0625rem]"
                  data-reveal
                  style="--reveal-delay:120ms"
                >
                  {lede}
                </p>
              </div>
            )}
          </div>
        </header>
      )
    }
    <div class:list={['relative', hasHeader && 'mt-10 lg:mt-20']}>
      <slot />
    </div>
  </div>
</section>
