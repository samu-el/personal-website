      "locked": false,
      "id": "el0017",
      "type": "text",
      "x": 60,
      "y": 660,
      "width": 714.56,
      "height": 52.5,
      "text": "Build-time secrets (Spotify, GitHub token) are read through process.env in CI only —\nAstro inlines nothing into client JS except PUBLIC_*. The Worker holds the refresh token\nas an encrypted Worker secret. The page only ever sees trimmed JSON.",
      "originalText": "Build-time secrets (Spotify, GitHub token) are read through process.env in CI only —\nAstro inlines nothing into client JS except PUBLIC_*. The Worker holds the refresh token\nas an encrypted Worker secret. The page only ever sees trimmed JSON.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
